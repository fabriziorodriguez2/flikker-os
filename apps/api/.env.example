# Required in production
# PostgreSQL connection string used by Prisma CLI and the NestJS runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# JWT signing secret. Use a long random value in production.
JWT_SECRET="change-me-in-production"

# Public URL where this API is reachable. Used to generate QR redirect URLs
# and public widget URLs. Must not point to localhost in production.
API_BASE_URL="https://api.example.com"

# Public URL where the frontend is reachable. Used for QR landing redirects.
WEB_BASE_URL="https://app.example.com"

# Optional with safe defaults
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App runtime
PORT=3000
NODE_ENV=development
