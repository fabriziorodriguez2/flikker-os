# ─── Base de datos ────────────────────────────────────────────
# URL PostgreSQL usada por Prisma CLI y por el runtime de NestJS.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB"

# ─── Autenticación ────────────────────────────────────────────
# Secreto largo para firmar JWT. Generar uno nuevo para producción.
JWT_SECRET="genera-uno-con: node -e \"console.log(require('crypto').randomBytes(64).toString('hex'))\""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="90d"
JWT_IMPERSONATION_EXPIRES_IN="1h"

# ─── URLs del sistema ─────────────────────────────────────────
# URL pública del API, sin trailing slash. Se usa para QR redirects y widgets.
API_BASE_URL="https://tu-api.railway.app"
# URL pública de la web, sin trailing slash. Se usa para landings públicas.
WEB_BASE_URL="https://flikker.site"
# URL pública de la app web para links de tracking enviados por WhatsApp.
APP_PUBLIC_URL="https://flikker.site"
# URL pública alternativa de la web; fallback para widgets/snippets.
WEB_PUBLIC_URL="https://flikker.site"
# URL desde donde se servirá widget.js si vive separado del API.
WIDGET_BASE_URL="https://tu-api.railway.app"

# ─── Redis / BullMQ ───────────────────────────────────────────
# Obtener desde el servicio Redis en Railway → Variables → REDIS_URL.
REDIS_URL="redis://default:PASSWORD@HOST:PORT"
# Alternativa si no usás REDIS_URL. El código usa REDIS_HOST + REDIS_PORT.
REDIS_HOST="HOST"
REDIS_PORT="6379"

# ─── WhatsApp ───────────────────────────────────────────────────
# Cuál proveedor usa WhatsAppBspService. "whapi" (default, sin tocar nada) o
# "wasender" — ver `whatsapp-provider.factory.ts`. Cambiar esto es TODO el
# cutover: no hace falta ningún otro cambio de código ni de deploy.
WHATSAPP_PROVIDER="whapi"

# Whapi.cloud — proveedor original. Token desde https://app.whapi.cloud →
# tu canal → API Token. Se mantiene disponible para rollback hasta la
# limpieza final (ver informe de migración, "## Plan para retirar WHAPI").
WHAPI_TOKEN="tu-token-de-whapi"
WHAPI_BASE_URL="https://gate.whapi.cloud"

# WaSenderAPI — proveedor nuevo. Key desde tu sesión en wasenderapi.com.
WASENDER_API_KEY="tu-api-key-de-wasenderapi"
# Opcional — solo si no vas a usar el default (https://www.wasenderapi.com).
# WASENDER_BASE_URL="https://www.wasenderapi.com"
# Opcional — solo si vas a configurar el webhook POST /webhooks/wasender.
# WASENDER_WEBHOOK_SECRET="tu-webhook-secret-de-wasenderapi"

# ─── Email transaccional (Resend) ─────────────────────────────
# API key desde https://resend.com/api-keys. Si falta, los jobs loguean y no envían email.
RESEND_API_KEY="re_xxxxxxxxx"
# Remitente verificado en Resend, ej: Flikker <notificaciones@tu-dominio.com>.
RESEND_FROM_EMAIL="Flikker <notificaciones@tu-dominio.com>"
RESEND_BASE_URL="https://api.resend.com"

# ─── Workers / Crons (opcionales, tienen defaults) ────────────
# Delay en ms antes de enviar el pedido de reseña (default: 1800000 = 30 min).
REVIEW_REQUEST_DELAY_MS="1800000"
# Delay en ms para mensajes del bot (default interno del worker).
WHATSAPP_BOT_REVIEW_DELAY_MS="7200000"
# Cron para campañas Repeats (default: 9am todos los días).
REPEATS_CRON="0 9 * * *"
# Cron para detección de reseñas Google (default: 3am todos los días).
GOOGLE_REVIEW_DETECTION_CRON="0 3 * * *"

# ─── Scrape.do — proxy para detección de reseñas Google ───────
# Obtener token en scrape.do — 1.000 requests/mes gratis.
SCRAPE_DO_TOKEN="33d821d856574610b38d25bf1332ad5337245b5492e"

# ─── Google Business Profile OAuth ────────────────────────────
# Credenciales OAuth globales de la app Flikker.
# El refresh_token es por negocio y se guarda en Business.googleRefreshToken.
GOOGLE_BUSINESS_PROFILE_CLIENT_ID=""
GOOGLE_BUSINESS_PROFILE_CLIENT_SECRET=""

# ─── Entorno ──────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"

# ─── AI Layer (Fase F) — todo opcional, apagado por default ───
# Flikker funciona 100% con templates determinísticos sin ninguna de estas.
# Kill switch de plataforma. "true" para habilitar — cualquier otro valor
# (incluido vacío/ausente) mantiene la IA apagada globalmente.
AI_ENABLED="false"
# Clave de OpenAI. Sin esto, cualquier llamada cae al fallback determinístico
# aunque AI_ENABLED sea "true". NUNCA hardcodear una clave real en el código.
OPENAI_API_KEY=""
# Modelo a usar. Default interno si se omite: gpt-4o-mini.
AI_MODEL=""
# Límites de uso por negocio (protección contra costo accidental). Defaults
# internos si se omiten: 50/día, 1000/mes.
AI_MAX_DAILY_GENERATIONS=""
AI_MAX_MONTHLY_GENERATIONS=""
# Timeout por llamada, en ms. Default interno: 6000.
AI_TIMEOUT_MS=""

# ─── Simulation Center (Platform Admin) — apagado por default ─
# Herramienta interna, solo para Platform Admin. Corre escenarios ficticios
# con reloj virtual sobre una base de datos SEPARADA — nunca toca datos
# productivos. Ver /platform/simulations.
# Kill switch. "true" para habilitar el panel — cualquier otro valor
# (incluido vacío/ausente) lo mantiene apagado y oculto.
SIMULATION_ENABLED="false"
# Postgres SEPARADA y exclusiva para datos simulados (fake businesses,
# customers, visits, etc.). Si falta, el panel muestra "no configurado" y
# NUNCA cae de vuelta a DATABASE_URL. Debe ser una base de datos distinta a
# la productiva.
SIMULATION_DATABASE_URL=""
# Corridas simultáneas permitidas. Default interno: 1.
SIMULATION_MAX_CONCURRENT_RUNS=""
# Tope de clientes ficticios por corrida. Default interno: 1000.
SIMULATION_MAX_CUSTOMERS=""
# Tope de días virtuales por corrida. Default interno: 90.
SIMULATION_MAX_DAYS=""
