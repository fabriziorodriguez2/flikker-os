generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum MembershipRole {
  OWNER
  ADMIN
  OPERATOR
  VIEWER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  REVOKED
}

enum BusinessStatus {
  DRAFT
  ONBOARDING
  ACTIVE
  INACTIVE
  SUSPENDED
  ARCHIVED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum CampaignChannel {
  QR_COUNTER
  QR_TABLE
  QR_CHECKOUT
  QR_PACKAGING
  WHATSAPP
  EMAIL
  SMS
  SOCIAL_BIO
  WEBSITE
  IN_PERSON
  EVENT
  OTHER
}

enum CampaignTemplateKind {
  post_service
  reactivation
  birthday
}

enum CampaignExecutionStatus {
  queued
  sent
  failed
  responded
}

enum DestinationType {
  GOOGLE_REVIEW
  CUSTOM_URL
  LANDING_ONLY
}

enum ReviewStatus {
  NEW
  REVIEWED
  RESPONDED
  ARCHIVED
}

enum ReviewSource {
  GOOGLE
  MANUAL
  IMPORT_CSV
  WHATSAPP_FEEDBACK
  EMAIL_FEEDBACK
  INTERNAL_FORM
  OTHER
}

enum WidgetStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum WidgetType {
  BADGE
  REVIEW_LIST
  REVIEW_GRID
}

enum ServiceEventCreatedVia {
  manual_panel
  whatsapp_bot
  csv_batch
  api
}

enum MessageChannel {
  whatsapp
}

enum MessageStatus {
  queued
  sent
  delivered
  read
  failed
}

enum WidgetMode {
  toast
  carousel
  grid
}

enum WidgetPosition {
  bottom_left
  bottom_right
}

enum WidgetEventType {
  impression
  click
  close
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id                   String   @id @default(uuid())
  email                String   @unique
  notificationEmail    String?  @map("notification_email")
  notificationWhatsapp String?  @map("notification_whatsapp")
  passwordHash         String
  firstName            String
  lastName             String
  isPlatformAdmin      Boolean  @default(false)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  memberships         Membership[]          @relation("UserMemberships")
  invitedMemberships  Membership[]          @relation("InvitedByUser")
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  impersonationLogs   ImpersonationLog[]
  auditLogs           AuditLog[]
  createdCampaigns    Campaign[]            @relation("CampaignCreator")
  createdReviews      Review[]              @relation("ReviewCreator")
  respondedReviews    Review[]              @relation("ReviewResponder")
  authoredResponses   Response[]            @relation("ResponseAuthor")
  statusChanges       ReviewStatusHistory[] @relation("StatusChanger")
}

// ---------------------------------------------------------------------------
// Session (refresh token store)
// ---------------------------------------------------------------------------

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Business
// ---------------------------------------------------------------------------

model Business {
  id                        String         @id @default(uuid())
  name                      String
  legalName                 String?
  slug                      String         @unique
  status                    BusinessStatus @default(DRAFT)
  industry                  String?
  vertical                  String?
  description               String?
  website                   String?
  phone                     String?
  email                     String?
  country                   String
  timezone                  String
  currency                  String
  logoUrl                   String?
  primaryColor              String?
  secondaryColor            String?
  toneOfVoice               String?
  whatsappUrl               String?
  shortBio                  String?
  signatureText             String?
  googleBusinessProfileUrl  String?
  googlePlaceId             String?        @map("google_place_id")
  googleRefreshToken        String?        @map("google_refresh_token")
  whatsappPhoneId           String?        @map("whatsapp_phone_id")
  messageQuotaMonthly       Int            @default(600) @map("message_quota_monthly")
  messageCountCurrentMonth  Int            @default(0) @map("message_count_current_month")
  reviewRequestsPausedUntil DateTime?      @map("review_requests_paused_until")
  defaultReviewRedirectUrl  String?
  isActive                  Boolean        @default(true)
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  archivedAt                DateTime?

  memberships        Membership[]
  branches           Branch[]
  subscription       Subscription?
  auditLogs          AuditLog[]
  campaigns          Campaign[]
  campaignExecutions CampaignExecution[]
  qrCodes            QrCode[]
  scanEvents         ScanEvent[]
  reviews            Review[]
  responses          Response[]
  widgets            Widget[]
  customers          Customer[]
  serviceEvents      ServiceEvent[]
  messages           Message[]
  feedbackResponses  FeedbackResponse[]
  googleReviews      GoogleReview[]
  impersonationLogs  ImpersonationLog[]
  widgetEvents       WidgetEvent[]
  reviewTags         ReviewTag[]
}

// ---------------------------------------------------------------------------
// ImpersonationLog (audited platform-admin business access)
// ---------------------------------------------------------------------------

model ImpersonationLog {
  id               String   @id @default(uuid())
  adminId          String
  targetBusinessId String
  createdAt        DateTime @default(now())

  admin          User     @relation(fields: [adminId], references: [id])
  targetBusiness Business @relation(fields: [targetBusinessId], references: [id])

  @@index([adminId])
  @@index([targetBusinessId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Branch (physical location of a business)
// ---------------------------------------------------------------------------

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  slug       String
  address    String?
  city       String?
  state      String?
  phone      String?
  email      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id])
  campaigns  Campaign[]
  qrCodes    QrCode[]
  scanEvents ScanEvent[]
  reviews    Review[]

  @@unique([businessId, slug])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Membership (user <-> business, with role and status)
// ---------------------------------------------------------------------------

model Membership {
  id              String           @id @default(uuid())
  userId          String
  businessId      String
  role            MembershipRole
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user      User     @relation("UserMemberships", fields: [userId], references: [id])
  business  Business @relation(fields: [businessId], references: [id])
  invitedBy User?    @relation("InvitedByUser", fields: [invitedByUserId], references: [id])

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// PasswordResetToken
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plan (logical pricing tiers — no billing integration yet)
// ---------------------------------------------------------------------------

model Plan {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  description         String?
  maxBranches         Int
  maxMembers          Int
  maxCampaigns        Int
  maxReviewsPerMonth  Int
  priceMonthly        Int      @default(0)
  priceUsd            Int      @default(0)
  setupFeeUsd         Int      @default(0)
  messageQuotaMonthly Int      @default(0)
  trialDays           Int      @default(0)
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

// ---------------------------------------------------------------------------
// Subscription (business <-> plan, one active per business)
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([planId])
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  actor    User?    @relation(fields: [actorUserId], references: [id])

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Campaign (review acquisition initiative)
// ---------------------------------------------------------------------------

model Campaign {
  id                String                @id @default(uuid())
  businessId        String
  branchId          String?
  name              String
  slug              String
  description       String?
  channel           CampaignChannel
  templateKind      CampaignTemplateKind? @map("template_kind")
  triggerOffsetDays Int?                  @map("trigger_offset_days")
  messageBody       String?               @map("message_body")
  offerText         String?               @map("offer_text")
  status            CampaignStatus        @default(DRAFT)
  destinationType   DestinationType
  destinationUrl    String?
  enableLanding     Boolean               @default(false)
  startsAt          DateTime?
  endsAt            DateTime?
  createdByUserId   String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  archivedAt        DateTime?

  business   Business            @relation(fields: [businessId], references: [id])
  branch     Branch?             @relation(fields: [branchId], references: [id])
  createdBy  User                @relation("CampaignCreator", fields: [createdByUserId], references: [id])
  qrCodes    QrCode[]
  scanEvents ScanEvent[]
  reviews    Review[]
  messages   Message[]
  executions CampaignExecution[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, templateKind, status])
}

// ---------------------------------------------------------------------------
// Customer (final patient/customer contacted for review requests)
// ---------------------------------------------------------------------------

model Customer {
  id         String    @id @default(uuid())
  businessId String
  name       String
  phoneE164  String    @map("phone_e164")
  email      String?
  birthday   DateTime?
  optedOut   Boolean   @default(false) @map("opted_out")
  isActive   Boolean   @default(true)
  tags       Json?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  business           Business            @relation(fields: [businessId], references: [id])
  serviceEvents      ServiceEvent[]
  messages           Message[]
  campaignExecutions CampaignExecution[]
  feedbackResponses  FeedbackResponse[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, phoneE164])
  @@index([businessId, birthday])
}

// ---------------------------------------------------------------------------
// ServiceEvent (attended service that can trigger review request timing)
// ---------------------------------------------------------------------------

model ServiceEvent {
  id          String                 @id @default(uuid())
  businessId  String
  customerId  String
  serviceType String
  eventAt     DateTime
  createdVia  ServiceEventCreatedVia
  createdAt   DateTime               @default(now())

  business Business  @relation(fields: [businessId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, createdAt])
  @@index([businessId, eventAt])
}

// ---------------------------------------------------------------------------
// Message (outbound review request with unique tracking token)
// ---------------------------------------------------------------------------

model Message {
  id             String         @id @default(uuid())
  businessId     String
  customerId     String
  campaignId     String?
  serviceEventId String?
  channel        MessageChannel
  trackingToken  String         @unique
  status         MessageStatus
  whatsappMsgId  String?        @map("whatsapp_msg_id")
  costUsd        Decimal?       @map("cost_usd")
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  clickedAt      DateTime?
  createdAt      DateTime       @default(now())

  business                Business            @relation(fields: [businessId], references: [id])
  customer                Customer            @relation(fields: [customerId], references: [id])
  campaign                Campaign?           @relation(fields: [campaignId], references: [id])
  serviceEvent            ServiceEvent?       @relation(fields: [serviceEventId], references: [id])
  feedbackResponses       FeedbackResponse[]
  campaignExecutions      CampaignExecution[]
  attributedGoogleReviews GoogleReview[]

  @@index([businessId])
  @@index([customerId])
  @@index([campaignId])
  @@index([serviceEventId])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// CampaignExecution (one Repeat campaign contact attempt per customer)
// ---------------------------------------------------------------------------

model CampaignExecution {
  id           String                  @id @default(uuid())
  businessId   String
  campaignId   String
  customerId   String
  messageId    String?
  status       CampaignExecutionStatus @default(queued)
  executedAt   DateTime                @default(now())
  sentAt       DateTime?
  respondedAt  DateTime?
  responseText String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@index([businessId])
  @@index([campaignId])
  @@index([customerId])
  @@index([messageId])
  @@index([campaignId, customerId, executedAt])
}

// ---------------------------------------------------------------------------
// FeedbackResponse (rating landing response from a message recipient)
// ---------------------------------------------------------------------------

model FeedbackResponse {
  id                  String   @id @default(uuid())
  businessId          String
  messageId           String
  customerId          String
  score               Int
  comment             String?
  redirectedToGoogle  Boolean
  acknowledgedByOwner Boolean  @default(false)
  createdAt           DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  message  Message  @relation(fields: [messageId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([messageId])
  @@index([customerId])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// GoogleReview (detected Google Business Profile review)
// ---------------------------------------------------------------------------

model GoogleReview {
  id                  String   @id @default(uuid())
  businessId          String
  googleReviewId      String   @map("google_review_id")
  reviewerName        String?  @map("reviewer_name")
  stars               Int
  text                String?
  postedAt            DateTime @map("posted_at")
  detectedAt          DateTime @default(now()) @map("detected_at")
  attributedMessageId String?  @map("attributed_message_id")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business          Business @relation(fields: [businessId], references: [id])
  attributedMessage Message? @relation(fields: [attributedMessageId], references: [id])

  @@unique([businessId, googleReviewId])
  @@index([businessId])
  @@index([businessId, postedAt])
  @@index([attributedMessageId])
}

// ---------------------------------------------------------------------------
// QrCode (traceable capture asset linked to a campaign)
// ---------------------------------------------------------------------------

model QrCode {
  id             String    @id @default(uuid())
  businessId     String
  campaignId     String
  branchId       String?
  slug           String    @unique
  label          String?
  destinationUrl String?
  isActive       Boolean   @default(true)
  scannedCount   Int       @default(0)
  lastScannedAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  business   Business    @relation(fields: [businessId], references: [id])
  campaign   Campaign    @relation(fields: [campaignId], references: [id])
  branch     Branch?     @relation(fields: [branchId], references: [id])
  scanEvents ScanEvent[]

  @@index([campaignId])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// ScanEvent (immutable record of each QR scan / link click)
// ---------------------------------------------------------------------------

model ScanEvent {
  id           String   @id @default(uuid())
  qrCodeId     String
  campaignId   String
  businessId   String
  branchId     String?
  ipHash       String?
  userAgent    String?
  referer      String?
  deviceType   String?
  redirectedTo String?
  landingShown Boolean  @default(false)
  isDuplicate  Boolean  @default(false)
  scannedAt    DateTime

  qrCode   QrCode   @relation(fields: [qrCodeId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  business Business @relation(fields: [businessId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  @@index([qrCodeId])
  @@index([campaignId])
  @@index([businessId])
  @@index([scannedAt])
  @@index([qrCodeId, ipHash, scannedAt])
}

// ---------------------------------------------------------------------------
// Review (core review entity — inbox item)
// ---------------------------------------------------------------------------

model Review {
  id                String       @id @default(uuid())
  businessId        String
  branchId          String?
  campaignId        String?
  source            ReviewSource
  externalReviewId  String?
  authorDisplayName String?
  rating            Int
  title             String?
  content           String?
  reviewedAt        DateTime
  ingestedAt        DateTime     @default(now())
  status            ReviewStatus @default(NEW)
  language          String?
  isHighlighted     Boolean      @default(false)
  respondedAt       DateTime?
  respondedByUserId String?
  metadataJson      Json?
  createdByUserId   String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  archivedAt        DateTime?

  business      Business              @relation(fields: [businessId], references: [id])
  branch        Branch?               @relation(fields: [branchId], references: [id])
  campaign      Campaign?             @relation(fields: [campaignId], references: [id])
  createdBy     User?                 @relation("ReviewCreator", fields: [createdByUserId], references: [id])
  respondedBy   User?                 @relation("ReviewResponder", fields: [respondedByUserId], references: [id])
  response      Response?
  tagRelations  ReviewTagRelation[]
  statusHistory ReviewStatusHistory[]

  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, source])
  @@index([businessId, rating])
  @@index([businessId, reviewedAt])
  @@index([branchId])
  @@index([campaignId])
  @@index([respondedByUserId])
}

// ---------------------------------------------------------------------------
// Response (manual response attached to a review)
// ---------------------------------------------------------------------------

model Response {
  id                String   @id @default(uuid())
  businessId        String
  reviewId          String   @unique
  content           String
  respondedByUserId String
  respondedAt       DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  business    Business @relation(fields: [businessId], references: [id])
  review      Review   @relation(fields: [reviewId], references: [id])
  respondedBy User     @relation("ResponseAuthor", fields: [respondedByUserId], references: [id])

  @@index([businessId])
  @@index([reviewId])
  @@index([respondedByUserId])
}

// ---------------------------------------------------------------------------
// ReviewTag (reusable tag per business)
// ---------------------------------------------------------------------------

model ReviewTag {
  id         String   @id @default(uuid())
  businessId String
  name       String
  slug       String
  color      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business     Business            @relation(fields: [businessId], references: [id])
  tagRelations ReviewTagRelation[]

  @@unique([businessId, slug])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// ReviewTagRelation (many-to-many: review <-> tag)
// ---------------------------------------------------------------------------

model ReviewTagRelation {
  id        String   @id @default(uuid())
  reviewId  String
  tagId     String
  createdAt DateTime @default(now())

  review Review    @relation(fields: [reviewId], references: [id])
  tag    ReviewTag @relation(fields: [tagId], references: [id])

  @@unique([reviewId, tagId])
  @@index([reviewId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// ReviewStatusHistory (immutable audit trail of status changes)
// ---------------------------------------------------------------------------

model ReviewStatusHistory {
  id              String        @id @default(uuid())
  reviewId        String
  fromStatus      ReviewStatus?
  toStatus        ReviewStatus
  changedByUserId String?
  reason          String?
  createdAt       DateTime      @default(now())

  review    Review @relation(fields: [reviewId], references: [id])
  changedBy User?  @relation("StatusChanger", fields: [changedByUserId], references: [id])

  @@index([reviewId])
}

// ---------------------------------------------------------------------------
// Widget (public social proof surface)
// ---------------------------------------------------------------------------

model Widget {
  id              String         @id @default(uuid())
  businessId      String
  name            String
  status          WidgetStatus   @default(DRAFT)
  type            WidgetType
  mode            WidgetMode     @default(toast)
  position        WidgetPosition @default(bottom_right)
  publicToken     String         @unique
  title           String?
  maxItems        Int            @default(6)
  minStars        Int            @default(4) @map("min_stars")
  maxReviewsShown Int            @default(6) @map("max_reviews_shown")
  primaryColor    String?        @map("primary_color")
  rotationSeconds Int            @default(8) @map("rotation_seconds")
  enabled         Boolean        @default(true)
  showAuthorName  Boolean        @default(true)
  showDate        Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([businessId, status])
}

// ---------------------------------------------------------------------------
// WidgetEvent (public widget analytics event)
// ---------------------------------------------------------------------------

model WidgetEvent {
  id             String          @id @default(uuid())
  businessId     String
  eventType      WidgetEventType
  googleReviewId String?         @map("googleReviewId")
  referrer       String?
  createdAt      DateTime        @default(now())

  business Business @relation(fields: [businessId], references: [id])

  @@index([businessId])
  @@index([businessId, createdAt])
}
