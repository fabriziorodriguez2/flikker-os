  FREE_TRIAL
  BASE
  PRO
}

enum BusinessGoalType {
  REVIEWS
  CONTACTS
  CAMPAIGN
}

enum MessageStatus {
  queued
  /// Claimed by a dispatcher that is actively calling the provider right now.
  /// Only Retention V2's message dispatcher uses this today — it is what
  /// makes the atomic claim-before-send race-safe (a second worker racing
  /// the same row sees it is no longer `queued` and backs off instead of
  /// sending twice).
  sending
  sent
  delivered
  read
  failed
}

enum AppointmentNotificationStatus {
  SENT
  FAILED
}

enum WidgetMode {
  toast
  carousel
  grid
}

