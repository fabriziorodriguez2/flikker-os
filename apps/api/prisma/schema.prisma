// ---------------------------------------------------------------------------
// Benefit (optional retention incentive offered by a business)
// ---------------------------------------------------------------------------
// A business may offer zero or many benefits, but only one may be active at a
// time (enforced by a partial unique index in the migration + service logic).
// Designed to be extended later (coupons, dynamic QR codes, points, stamps,
// cashback, per-segment / birthday benefits) without reshaping this table.

model Benefit {
  id          String      @id @default(uuid())
  businessId  String      @map("business_id")
  type        BenefitType
  title       String
  description String?
  terms       String?
  startDate   DateTime?   @map("start_date")
  endDate     DateTime?   @map("end_date")
  recurrence  String?
  active      Boolean     @default(false)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  business                     Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  /// Negocios que eligieron este beneficio como regalo de bienvenida. En la
  /// práctica 0 o 1: un Benefit pertenece a un solo negocio.
  welcomeForBusinesses         Business[]                    @relation("BusinessWelcomeBenefit")
  participations               BenefitParticipation[]
  raffleDraws                  RaffleDraw[]
  /// Set only on the inert Benefit rows Retention V2 issues through.
  retentionVariant             RetentionVariant?
  /// Piloto V2 — set when the owner authorized this Benefit for Retention V2
  /// (recovery and/or reward goals) from /dashboard/beneficios. Distinct from
  /// `retentionVariant` above: this points at the real, editable Benefit the
  /// owner sees; `retentionVariant` points at an internal, inert copy.
  retentionIncentiveDefinition RetentionIncentiveDefinition?

  @@index([businessId])
  @@index([businessId, active])
  @@map("benefits")
}

// ---------------------------------------------------------------------------
// BenefitParticipation (a customer opting into a benefit — e.g. a raffle entry)
// ---------------------------------------------------------------------------

/// Quién/qué originó una emisión de `BenefitParticipation`. Pedido explícito:
/// cada emisión tiene que poder distinguir su origen — nunca inferirlo del
/// tipo de Benefit ni de qué relación inversa tenga colgada.
enum BenefitIssuanceSource {
  PROMOTION
  WELCOME
  REACTIVATION
  REWARD_GOAL
  RAFFLE
  /// El beneficio `active` que el check-in ofrece por default, fuera de
  /// cualquier promoción/bienvenida/reactivación explícita.
  CHECKIN_ACTIVE
  /// Filas de antes de que existiera esta columna — backfill best-effort,
  /// nunca se escribe desde código nuevo.
  LEGACY
}

model BenefitParticipation {
  id               String    @id @default(uuid())
  benefitId        String    @map("benefit_id")
  businessId       String    @map("business_id")
  customerId       String    @map("customer_id")
  /// Origen de ESTA emisión concreta — ver `BenefitIssuanceSource`. No
  /// determina por sí solo el comportamiento de reuso: eso lo decide cada
  /// adaptador (Promociones siempre crea fila nueva; bienvenida/check-in
  /// reabren su propia fila abierta; sorteos reabren por ciclo).
  source           BenefitIssuanceSource @map("source")
  /// Solo se completa cuando `source = PROMOTION` — la campaña manual
  /// (`ManualCampaign`, Notificaciones → Promociones) que disparó esta
  /// emisión concreta, para trazabilidad ("qué promoción le mandó esto").
  /// `REACTIVATION`/`REWARD_GOAL` ya tienen su propia trazabilidad vía las
  /// relaciones inversas `retentionAssignment`/`rewardGoal` — no se duplica
  /// acá.
  campaignId       String?   @map("manual_campaign_id")
  // Set when this entry is "closed" by a monthly raffle draw. Null means the
  // entry belongs to the currently open (not-yet-drawn) cycle. This is how the
  // participant list resets month to month without deleting any data.
  raffleDrawId     String?   @map("raffle_draw_id")
  // Redemption (non-raffle benefits): a unique opaque code the customer shows to
  // staff. `redeemedAt` != null means it was used — atomically guarded so a
  // benefit can never be redeemed twice.
  redemptionCode   String?   @unique @map("redemption_code")
  redeemedAt       DateTime? @map("redeemed_at")
  redeemedByUserId String?   @map("redeemed_by_user_id")
  redeemedVisitId  String?   @map("redeemed_visit_id")
  /// Per-issue expiry. The QR flow leaves this null (validity comes from the
  /// Benefit's own window); Retention V2 sets it because each customer's reward
  /// expires a fixed number of days after it was issued to them.
  expiresAt        DateTime? @map("expires_at")
  /// Snapshot de `Benefit.title` en el momento en que se otorgó ESTA
  /// participación — no una referencia viva. Sin esto, editar el título de un
  /// beneficio reescribía silenciosamente lo que el historial dice que un
  /// cliente recibió en el pasado (Programa → Historial, actividad del
  /// cliente, pantalla de canje). `Benefit.title` puede seguir cambiando
  /// libremente una vez que ya no hay ninguna promesa viva colgando de él;
  /// esta columna es la que garantiza que el pasado no se reescriba con ese
  /// cambio. Nullable solo por las filas anteriores a esta columna — se
  /// backfillea con el título vigente al migrar (la mejor aproximación
  /// disponible) y todo lo que se crea desde acá en adelante la escribe
  /// siempre.
  benefitTitleSnapshot String? @map("benefit_title_snapshot")
  createdAt        DateTime  @default(now()) @map("created_at")

  benefit             Benefit              @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  business            Business             @relation(fields: [businessId], references: [id])
  customer            Customer             @relation(fields: [customerId], references: [id])
  campaign            ManualCampaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  raffleDraw          RaffleDraw?          @relation(fields: [raffleDrawId], references: [id], onDelete: SetNull)
  retentionAssignment RetentionAssignment?
  rewardGoal          CustomerRewardGoal?

  // NO @@unique([benefitId, customerId]) — un cliente puede recibir el MISMO
  // Benefit múltiples veces (pedido explícito: cada entrega es una emisión
  // propia, auditable para siempre, código de canje propio). El índice
  // sigue existiendo para las mismas queries de siempre, solo que ya no es
  // único.
  @@index([benefitId, customerId])
  @@index([businessId])
  @@index([benefitId])
  @@index([customerId])
  @@index([raffleDrawId])
  @@index([campaignId])
  @@map("benefit_participations")
}

// ---------------------------------------------------------------------------
// ProgramAuditEvent (Programa → Historial)
// ---------------------------------------------------------------------------
// Bitácora MÍNIMA — solo para los cambios de configuración de Programa que no
// dejan ningún rastro con fecha en otro lado (activar/desactivar la tarjeta,
// cambiar sellos o recompensa, autorizar/revocar un beneficio para
// reactivación, crear/editar un beneficio). Todo lo demás que tiene su propia
// fecha real (beneficio ofrecido/canjeado, tarjeta completada/canjeada) se
// lee directamente de Benefit/BenefitParticipation/CustomerRewardGoal — no se
// duplica acá. Deliberadamente NO es un event-sourcing genérico: un tipo fijo
// por evento y un mensaje ya redactado, nada de reconstrucción de estado.
enum ProgramAuditEventType {
  card_activated
  card_deactivated
  card_config_changed
  benefit_created
  benefit_edited
  benefit_reactivation_authorized
  benefit_reactivation_revoked
  /// The monthly cap on automated incentives (RetentionSettings.
  /// maxAutomatedIncentivesPerMonth) changed — worth its own history entry
  /// because it silently changes whether an already-authorized benefit can
  /// actually be issued, without touching the benefit itself.
  automation_incentive_limit_changed
  /// "Te extrañamos" o "Cerca del premio" cambió de ON a OFF o de OFF a ON
  /// desde `PATCH /notifications/automations` — la ÚNICA acción real que
  /// puede apagar una automatización después del default del onboarding.
  /// Sin este evento, "el dueño lo apagó" y "nunca se inicializó" son
  /// indistinguibles mirando solo el booleano actual.
  automation_toggled
  /// Programa → Configuración: el OWNER prendió/apagó la visibilidad
  /// pública del catálogo de Beneficios (`RetentionSettings.benefitsEnabled`)
  /// — independiente de `card_activated`/`card_deactivated`, que son sellos.
  benefits_catalog_activated
  benefits_catalog_deactivated
}

model ProgramAuditEvent {
  id         String                @id @default(uuid())
  businessId String                @map("business_id")
  type       ProgramAuditEventType
  /// Ya redactado en español al momento de escribir el evento — el timeline
  /// no vuelve a interpretar `metadata` para mostrar texto.
  message    String
  /// Null cuando el actor ya no se puede resolver (cuenta borrada) — el
  /// evento se conserva igual, solo sin atribución.
  actorUserId String?  @map("actor_user_id")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@map("program_audit_events")
}

// ---------------------------------------------------------------------------
// RaffleDraw (monthly winner draw for a raffle-type benefit)
// ---------------------------------------------------------------------------
// One row per (benefit, calendar month). Drawing closes the current cycle by
// stamping every open BenefitParticipation with this draw's id — that's the
// "reset": next month's entrants start out unclosed (raffleDrawId = null)
// again, with no data deleted.

model RaffleDraw {
  id                String    @id @default(uuid())
  benefitId         String    @map("benefit_id")
  businessId        String    @map("business_id")
  /// Local calendar month being closed, e.g. "2026-07".
  periodKey         String    @map("period_key")
  winnerCustomerId  String?   @map("winner_customer_id")
  participantsCount Int       @map("participants_count")
  drawnAt           DateTime  @default(now()) @map("drawn_at")
  notifiedAt        DateTime? @map("notified_at")

  benefit        Benefit                @relation(fields: [benefitId], references: [id], onDelete: Cascade)
  business       Business               @relation(fields: [businessId], references: [id])
  winner         Customer?              @relation(fields: [winnerCustomerId], references: [id], onDelete: Restrict)
  participations BenefitParticipation[]

  @@unique([benefitId, periodKey])
  @@index([businessId])
  @@index([benefitId])
  @@map("raffle_draws")
}

// ---------------------------------------------------------------------------
// RetentionSequence (time-based re-engagement sequence, one per business)
// ---------------------------------------------------------------------------
// Fully configurable: steps live in the DB (no hardcoded days). Flikker does
// not know when a customer returns; steps fire relative to the customer's
// registration date (Customer.createdAt).

model RetentionSequence {
  id         String   @id @default(uuid())
  businessId String   @unique @map("business_id")
  enabled    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  steps    RetentionStep[]

  @@map("retention_sequences")
}

model RetentionStep {
  id          String   @id @default(uuid())
  sequenceId  String   @map("sequence_id")
  businessId  String   @map("business_id")
  offsetDays  Int      @map("offset_days")
  messageBody String   @map("message_body")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sequence RetentionSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  business Business          @relation(fields: [businessId], references: [id])
  sends    RetentionSend[]

  @@unique([sequenceId, offsetDays])
  @@index([businessId])
  @@index([sequenceId])
  @@map("retention_steps")
}

// Send history — anti-duplicate is keyed by (customerId, offsetDays) so that
// editing/recreating steps never re-messages a customer for a day they already
// received. stepId is nullable (SetNull) so history survives step deletion.

model RetentionSend {
  id         String        @id @default(uuid())
  businessId String        @map("business_id")
  customerId String        @map("customer_id")
  stepId     String?       @map("step_id")
  offsetDays Int           @map("offset_days")
  messageId  String?       @map("message_id")
  status     MessageStatus @default(queued)
  createdAt  DateTime      @default(now()) @map("created_at")

  business Business       @relation(fields: [businessId], references: [id])
  customer Customer       @relation(fields: [customerId], references: [id])
  step     RetentionStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  message  Message?       @relation(fields: [messageId], references: [id])

  @@unique([customerId, offsetDays])
  @@index([businessId])
  @@index([customerId])
  @@index([stepId])
  @@map("retention_sends")
}

// ---------------------------------------------------------------------------
// VisitSource (a named QR/NFC/link check-in point with its own opaque token)
// ---------------------------------------------------------------------------
// The public entry is /check-in/{token}. Each business has exactly one default
// source (enforced by a partial unique index in the migration) that the legacy
// /qr/{businessId} flow resolves to, so existing QRs keep working unchanged.

model VisitSource {
  id            String          @id @default(uuid())
  businessId    String          @map("business_id")
  name          String
  type          VisitSourceType @default(qr)
  token         String          @unique
  isDefault     Boolean         @default(false) @map("is_default")
  isActive      Boolean         @default(true) @map("is_active")
  scannedCount  Int             @default(0) @map("scanned_count")
  lastScannedAt DateTime?       @map("last_scanned_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  visits   Visit[]
  events   CustomerEvent[]

  @@index([businessId])
  @@index([businessId, isActive])
  @@map("visit_sources")
}

// ---------------------------------------------------------------------------
// Visit (a check-in — first visit or return — of a customer to a business)
// ---------------------------------------------------------------------------
// Created only on a REAL signal (registration, check-in, redemption). Never
// backfilled historically. Dedup is transactional (advisory lock on
// business+customer) using configurable Business rules; `visitDayKey` (local
// calendar day in the business timezone) enables fast same-day counting.

model Visit {
  id               String                @id @default(uuid())
  businessId       String                @map("business_id")
  customerId       String                @map("customer_id")
  sourceId         String?               @map("source_id")
  campaignId       String?               @map("campaign_id")
  messageId        String?               @map("message_id")
  occurredAt       DateTime              @default(now()) @map("occurred_at")
  visitDayKey      String                @map("visit_day_key")
  verificationType VisitVerificationType @map("verification_type")
  attributionType  VisitAttributionType  @default(organic) @map("attribution_type")
  isReturn         Boolean               @default(false) @map("is_return")
  metadata         Json?
  createdAt        DateTime              @default(now()) @map("created_at")

  business          Business           @relation(fields: [businessId], references: [id])
  customer          Customer           @relation(fields: [customerId], references: [id])
  source            VisitSource?       @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  campaign          Campaign?          @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  message           Message?           @relation(fields: [messageId], references: [id], onDelete: SetNull)
  events            CustomerEvent[]
  retentionOutcomes RetentionOutcome[]
  /// At most one feedback per visit — see `CheckinFeedback.visitId`.
  checkinFeedback   CheckinFeedback?

  @@index([businessId])
  @@index([businessId, occurredAt])
  @@index([customerId])
  @@index([customerId, occurredAt])
  @@index([businessId, customerId, visitDayKey])
  @@index([campaignId])
  @@index([sourceId])
  @@map("visits")
}

// ---------------------------------------------------------------------------
// CustomerSession (persistent recognition token for the public check-in)
// ---------------------------------------------------------------------------
// The raw opaque token lives ONLY in an httpOnly cookie. We store just its
// SHA-256 hash — never the raw token, never the phone or customer id in the
// browser. Recognition = hash the cookie token, look up a live (not revoked,
// not expired) session.

model CustomerSession {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  customerId String    @map("customer_id")
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_sessions")
}

// ---------------------------------------------------------------------------
// CustomerVerification (one-time WhatsApp code to recover a profile safely)
// ---------------------------------------------------------------------------
// A phone number alone must NOT grant access. Recovering a profile on a new
// device requires a one-time code sent by WhatsApp. Only the code's hash is
// stored. Until consumed: no session, no private benefits, no history.

model CustomerVerification {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  customerId String    @map("customer_id")
  codeHash   String    @map("code_hash")
  purpose    String    @default("session_recovery")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@index([customerId])
  @@index([expiresAt])
  @@map("customer_verifications")
}

// ---------------------------------------------------------------------------
// CustomerEvent (append-only timeline backbone)
// ---------------------------------------------------------------------------
// The single source of truth for events that have no other home. Message
// delivery events are read from Message, not duplicated here. messageId /
// benefitId are carried in `metadata` to avoid over-coupling existing models.

model CustomerEvent {
  id         String            @id @default(uuid())
  businessId String            @map("business_id")
  customerId String            @map("customer_id")
  type       CustomerEventType
  visitId    String?           @map("visit_id")
  sourceId   String?           @map("source_id")
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  business Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit    Visit?       @relation(fields: [visitId], references: [id], onDelete: SetNull)
  source   VisitSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([businessId, createdAt])
  @@index([customerId])
  @@index([customerId, createdAt])
  @@index([businessId, type])
  @@map("customer_events")
}

// ---------------------------------------------------------------------------
// SimulationRun (Simulation Center — platform admin only)
// ---------------------------------------------------------------------------
// Bookkeeping row for an internal Platform Admin tool that validates Flikker
// V2's real business logic against fictitious data — NEVER against real
// Business/Customer rows. This row lives in the main database purely as a
// status/results ledger the admin panel can query directly; the simulated
// data itself (fake businesses/customers/visits/etc.) lives entirely in the
// separate SIMULATION_DATABASE_URL database, so this table never joins to
// real tenant tables and never carries a businessId.

enum SimulationStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum SimulationScenario {
  BASELINE_HEALTHY
  LOW_CHECKIN_COMPLIANCE
  HIGH_CHECKIN_COMPLIANCE
  PROMO_SENSITIVE
  PROGRESS_SENSITIVE
  HIGH_CHURN
  LOW_BUDGET
  AI_PROVIDER_FAILURE
  MESSAGE_PROVIDER_FAILURE
  OPTIMIZATION_STRESS
  /// Fix de diseño pre-piloto — CONTROL 30 / REMINDER 70, dos brazos únicamente.
  TWO_ARM_REMINDER
  /// Fix de diseño pre-piloto — CONTROL 30 / SOFT_BENEFIT 70, con economía real.
  TWO_ARM_SOFT_BENEFIT
  /// Fix de diseño pre-piloto — objective REWARD_GOAL_PROGRESS; población =
  /// solo customers con CustomerRewardGoal ACTIVE. CONTROL 30 / PROGRESS_REMINDER 70.
  REWARD_PROGRESS
  /// Fix de diseño pre-piloto — ground truth con dos challengers a <1pp entre sí.
  NEAR_TIE
  /// Fix de diseño pre-piloto — ground truth con un ganador claramente superior.
  STRONG_SIGNAL
}

model SimulationRun {
  id       String             @id @default(uuid())
  status   SimulationStatus   @default(PENDING)
  scenario SimulationScenario

  seed          Int
  days          Int
  customerCount Int     @map("customer_count")
  withAi        Boolean @default(false) @map("with_ai")

  /// Fully resolved input (scenario defaults + overrides + failure-injection
  /// rates) exactly as the engine ran it — never contains secrets (§36).
  configuration Json

  /// Structured SimulationResult (§21) once COMPLETED — null otherwise.
  results       Json?
  /// Diagnosis + recommendations + per-section summaries (§29-§32).
  summary       Json?
  /// Set only when status = FAILED. A short, human-readable reason — never
  /// a raw stack trace or internal detail leaked to the admin panel.
  failureReason String? @map("failure_reason")

  /// 0-100. Updated by the worker between virtual days (§27).
  progress          Int @default(0) @map("progress")
  currentVirtualDay Int @default(0) @map("current_virtual_day")

  /// Cooperative cancel flag the worker checks between days/rounds — never
  /// a hard kill, so no orphaned data is left behind (§28).
  cancelRequested Boolean @default(false) @map("cancel_requested")

  createdByUserId String    @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")

  createdBy User @relation("SimulationRunCreator", fields: [createdByUserId], references: [id])

  @@index([status])
  @@index([createdAt])
  @@map("simulation_runs")
}
