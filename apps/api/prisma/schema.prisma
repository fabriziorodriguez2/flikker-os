  bottom_right
}

enum WidgetEventType {
  impression
  click
  close
}

enum ShopifyOrderStatus {
  pending
  scheduled
  skipped
  failed
}

// Which public experience a business is on. Rollout is per business so Legacy
// and Check-in V2 can coexist in a single deployment.
//   LEGACY     → /qr/{businessId}: capture + review request. No Visit, no
//                VisitSource, no CustomerSession. The behaviour that existed
//                before Check-in V2.
//   CHECKIN_V2 → /check-in/{token}: persistent session, visits, attribution.
// Switching is reversible and never deletes data (see PATCH
// /platform/businesses/:id/experience).
enum ExperienceVersion {
  LEGACY
  CHECKIN_V2
}

// ---------------------------------------------------------------------------
// Retention Engine V2 enums
// ---------------------------------------------------------------------------

// Behavioural segment, derived from real Visit history. Always computed from
// visits — never hand-assigned — so it cannot go stale silently.
enum CustomerSegment {
  NEW
  REPEAT
  FREQUENT
  AT_RISK
  INACTIVE
  RECOVERED
}

// What a retention campaign is trying to achieve. Winning back a once-frequent
// customer is a different problem from getting a first-timer to come back.
enum RetentionObjective {
  SECOND_VISIT
  AT_RISK_RECOVERY
  INACTIVE_RECOVERY
  /// Pre-piloto fix (Simulation Center finding) — loyalty/progress reminders
  /// for a customer who already has an ACTIVE CustomerRewardGoal, decoupled
  /// from AT_RISK/INACTIVE recovery. Recruitment for this objective does NOT
  /// go through `objectiveForSegment`/`resolveApplicable` (segment-based) —
  /// its population is "has an active reward goal", which is orthogonal to
  /// CustomerSegment and in practice excludes AT_RISK/INACTIVE entirely
  /// (see reward-goal-rules.ts's REWARD_GOAL_TARGET_RANGE). See
  /// RetentionV2EvaluateService.evaluateBusinessForRewardGoalProgress.
  REWARD_GOAL_PROGRESS
}

// Strategy of an experiment variant. CONTROL receives nothing at all — it is
// what makes "how many would have returned anyway?" answerable.
enum RetentionStrategyType {
  CONTROL
  REMINDER
  SOFT_BENEFIT
  STRONG_BENEFIT
  /// Fase E §25 — reminds the customer of progress toward an ALREADY-existing
  /// CustomerRewardGoal. Never emits a benefit and never creates a goal; if no
  /// ACTIVE goal exists for the customer, this strategy is simply not
  /// applicable (see eligibility.ts).
  PROGRESS_REMINDER
}

/// Fase E — lifecycle of a CustomerRewardGoal. ACTIVE (accumulating) → UNLOCKED
/// (target visits reached, reward available) → REDEEMED (claimed, terminal).
/// EXPIRED and CANCELLED are terminal exits before REDEEMED.
enum RewardGoalStatus {
  ACTIVE
  UNLOCKED
  REDEEMED
  EXPIRED
  CANCELLED
}

enum RetentionExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

// Lifecycle of one participant inside an experiment.
//   PENDING    → recruited, the send worker has not processed it yet
//   OBSERVING  → CONTROL: deliberately receives nothing, we only watch
//   SENT       → a message went out (and a reward was issued if applicable)
//   SKIPPED    → re-validation failed right before sending; skipReason says why
enum RetentionAssignmentStatus {
  PENDING
  OBSERVING
  SENT
  SKIPPED
}

// Benefit types. `none` = business explicitly offers no benefit. New types can be
// added here as the offering grows (coupons, points, stamps, cashback, etc.).
enum BenefitType {
  none
  discount
  gift
  raffle
  promotion
  other
  /// Programa (CHECKIN_V2): "subí de tamaño / mejorá tu pedido gratis".
  /// Aditivo — ningún switch existente enumera BenefitType de forma
  /// exhaustiva, así que agregarlo no cambia comportamiento previo.
  upgrade
}

// ---------------------------------------------------------------------------
// Check-in / retention enums
// ---------------------------------------------------------------------------

// Physical/logical origin of a check-in point. Each source has its own opaque
// token and powers the public /check-in/{token} entry.
enum VisitSourceType {
  qr
  nfc
  link
  manual
}

// How a visit was verified. Drives trust: a persistent-session or staff-
// confirmed visit is stronger evidence than an anonymous scan.
enum VisitVerificationType {
  persistent_session
  campaign_link
  benefit_redemption
  staff_confirmation
  manual
}

// What (if anything) a visit is attributed to. A visit can exist WITHOUT
// attribution (`organic`). `unknown` means we saw evidence of a campaign but
// not enough to attribute confidently. A visit is never attributed to more
// than one campaign.
enum VisitAttributionType {
  organic
  post_campaign_checkin
  confirmed_redemption
  unknown
}

// Append-only customer timeline vocabulary. Message delivery events
// (sent/delivered/read/clicked) are NOT mirrored here — they already live on
// Message and the timeline composes them from there; these are the events with
// no other home.
enum CustomerEventType {
  customer_registered
  customer_session_restored
  visit_created
  visit_duplicate_prevented
  benefit_viewed
  benefit_redeemed
  review_prompt_shown
  review_link_clicked
  /// "¿Cómo fue tu experiencia?" submitted right after a check-in — never
  /// gated on score, never tied to whether the customer later opens Google.
  feedback_submitted
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(uuid())
  email                 String    @unique
  notificationEmail     String?   @map("notification_email")
  notificationWhatsapp  String?   @map("notification_whatsapp")
  passwordHash          String
  firstName             String
  lastName              String
  isPlatformAdmin       Boolean   @default(false)
  isActive              Boolean   @default(true)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  /// Null = correo sin confirmar todavía. Alta self-service arranca en null;
  /// las cuentas que ya existían antes de que esta columna existiera se
  /// migran con `emailVerifiedAt = createdAt` (backfill en la migración) para
  /// no bloquear a nadie que ya venía usando Flikker. Las cuentas que crea
  /// Platform Admin (`platform.repository.ts`) se marcan verificadas en el
  /// momento: nunca pasan por el flujo de confirmación por correo.
  emailVerifiedAt       DateTime? @map("email_verified_at")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  memberships             Membership[]          @relation("UserMemberships")
  invitedMemberships      Membership[]          @relation("InvitedByUser")
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  impersonationLogs    ImpersonationLog[]
  auditLogs            AuditLog[]
  createdCampaigns     Campaign[]            @relation("CampaignCreator")
  createdReviews       Review[]              @relation("ReviewCreator")
  respondedReviews     Review[]              @relation("ReviewResponder")
  authoredResponses    Response[]            @relation("ResponseAuthor")
  statusChanges        ReviewStatusHistory[] @relation("StatusChanger")
  businessPlansCreated BusinessPlan[]        @relation("BusinessPlanCreator")
  simulationRuns       SimulationRun[]       @relation("SimulationRunCreator")
  programAuditEvents   ProgramAuditEvent[]
}

// ---------------------------------------------------------------------------
// Session (refresh token store)
// ---------------------------------------------------------------------------

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshTokenHash])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Business
// ---------------------------------------------------------------------------

model Business {
  id                           String            @id @default(uuid())
  name                         String
  legalName                    String?
  slug                         String            @unique
  status                       BusinessStatus    @default(DRAFT)
  industry                     String?
  vertical                     String?
  description                  String?
  website                      String?
  phone                        String?
  email                        String?
  country                      String
  timezone                     String
  currency                     String
  logoUrl                      String?
  primaryColor                 String?
  secondaryColor               String?
  toneOfVoice                  String?
  whatsappUrl                  String?
  shortBio                     String?
  signatureText                String?
  benefitText                  String?           @map("benefit_text")
  qrA4Title                    String?           @map("qr_a4_title")
  qrA4Subtitle                 String?           @map("qr_a4_subtitle")
  qrA4BgColor                  String?           @map("qr_a4_bg_color")
  /// Apariencia de la tarjeta de sellos que ve el cliente (Programa →
  /// Diseño). Los valores opcionales usan null para indicar "automático";
  /// el render final siempre valida contraste antes de aplicar colores.
  loyaltyCardColor             String?           @map("loyalty_card_color")
  loyaltyCardTextColor         String?           @map("loyalty_card_text_color")
  loyaltyCardBackgroundImage   String?           @map("loyalty_card_background_image")
  loyaltyStampAreaColor        String?           @map("loyalty_stamp_area_color")
  loyaltyStampColor            String?           @map("loyalty_stamp_color")
  loyaltyStampIcon             String?           @map("loyalty_stamp_icon")
  loyaltyShowBusinessName      Boolean           @default(true) @map("loyalty_show_business_name")
  /// Patrón decorativo detrás de los sellos — una de 8 keys fijas
  /// (`waves`/`bubbles`/`arcs`/`curved-lines`/`organic`/`geometric`/
  /// `confetti`, o `none`); null = sin patrón, igual que `none`. Sin
  /// validación de enum a nivel de base (mismo criterio que el resto de los
  /// campos `loyalty*` de acá arriba) — la valida el DTO.
  loyaltyStampBackgroundPattern String?          @map("loyalty_stamp_background_pattern")
  /// 0-100. Null = "Automático" (Flikker elige la intensidad según si la
  /// tarjeta es clara u oscura). Nunca se aplica crudo: el render siempre lo
  /// re-mapea a un techo de opacidad seguro para que el patrón nunca
  /// dificulte leer el sello.
  loyaltyStampBackgroundOpacity Int?             @map("loyalty_stamp_background_opacity")
  /// Programa → Página de inscripción. Encabezado propio, editable, para la
  /// landing pública de check-in (`/check-in/[token]`). Null = seguir usando
  /// el título del beneficio activo como encabezado (comportamiento previo a
  /// esta pantalla) — nunca se confunde con `benefitText`, que además decide
  /// la copia del subtítulo/botón y el mensaje de WhatsApp post-registro.
  checkinWelcomeMessage        String?           @map("checkin_welcome_message")
  /// Programa → Página de inscripción. Fondo elegido para el formulario
  /// público. Null = mantener la paleta automática derivada de la marca.
  checkinBackgroundColor       String?           @map("checkin_background_color")
  /// Regalo de bienvenida (Programa). Fuente de verdad EXPLÍCITA, separada
  /// de `Benefit.active`: `active` significa "beneficio visible en el
  /// check-in" y se re-asegura en cada visita, así que no puede representar
  /// "se entrega una sola vez, en la primera visita". Null = sin regalo de
  /// bienvenida, que es el comportamiento de todo negocio existente.
  welcomeBenefitId             String?           @map("welcome_benefit_id")
  /// True cuando el dueño YA decidió sobre el regalo de bienvenida, incluso
  /// si decidió que no. Distingue "todavía no lo preguntamos" de "dijo que
  /// no" — sin esto el wizard volvería a preguntar para siempre al reanudar,
  /// porque  significa las dos cosas.
  welcomeGiftDecided           Boolean           @default(false) @map("welcome_gift_decided")
  /// Mismo problema que welcomeGiftDecided, en el paso de Automatizaciones:
  /// "las dejé apagadas a propósito" y "todavía no llegué a ese paso" son
  /// ambos dos flags en false. Sin este campo el wizard manda al dueño de
  /// vuelta al paso 6 cada vez que refresca después de decir que no a todo.
  notificationsDecided         Boolean           @default(false) @map("notifications_decided")
  /// Onboarding self-service NUEVO (2 pasos). Igual filosofía que
  /// welcomeGiftDecided/notificationsDecided: distingue "el dueño todavía no
  /// llegó al paso 2" de "eligió Beneficios sin sellos", que en `Business` se
  /// ven idénticos si solo se mirara `rewardGoalsEnabled` (false en ambos
  /// casos). Se marca true al terminar el paso 2, sin importar qué camino
  /// eligió (Beneficios o Beneficios + sellos).
  retentionProgramDecided      Boolean           @default(false) @map("retention_program_decided")
  /// Self-service — acceso Pro TEMPORAL a Beneficios (30 días), no una
  /// "modalidad" fija: arranca la primera vez que el negocio prende de
  /// verdad `RetentionSettings.benefitsEnabled` (onboarding "solo
  /// Beneficios", o el toggle de Programa → Configuración más adelante,
  /// lo que ocurra primero) y nunca se reinicia por apagar/prender de
  /// nuevo. Independiente de `Subscription`/`Plan`: un negocio puede estar
  /// en el plan Free de sellos Y tener un trial de Beneficios corriendo al
  /// mismo tiempo — por eso vive acá y no en Subscription.status, que es
  /// una sola fila por negocio. Null = todavía nunca lo activó (LEGACY,
  /// Platform Admin, o self-service que solo eligió sellos) — nunca
  /// bloqueado. Ver `PlansService#isBenefitsBlocked`.
  benefitsTrialStartedAt       DateTime?         @map("benefits_trial_started_at")
  benefitsTrialEndsAt          DateTime?         @map("benefits_trial_ends_at")
  /// Onboarding self-service: null mientras el dueño lo está completando.
  /// Es el ancla de reanudación — `POST /onboarding/business` reutiliza el
  /// negocio incompleto del usuario en vez de crear otro si refresca o
  /// vuelve atrás. Los negocios creados por Platform Admin nacen con fecha,
  /// así que nunca son candidatos a reanudar.
  onboardingCompletedAt        DateTime?         @map("onboarding_completed_at")
  googleBusinessProfileUrl     String?
  googlePlaceId                String?           @map("google_place_id")
  googleRefreshToken           String?           @map("google_refresh_token")
  googleReviewsLastSyncAt      DateTime?         @map("google_reviews_last_sync_at")
  /// Google Places API (New) — datos de solo lectura del Place conectado
  /// (Reseñas → Conectar Google). `googlePlaceId` y `googleBusinessProfileUrl`
  /// ya existían y NO se duplican: `googleBusinessProfileUrl`/
  /// `defaultReviewRedirectUrl` pasan a poblarse con el `writeAReviewUri` real
  /// de Google en vez del link armado a mano. Estos cuatro son estrictamente
  /// nuevos — Google no los expone en ningún campo existente.
  googlePlaceDisplayName       String?           @map("google_place_display_name")
  googlePlaceFormattedAddress  String?           @map("google_place_formatted_address")
  googlePlaceRating            Float?            @map("google_place_rating")
  googlePlaceUserRatingCount   Int?              @map("google_place_user_rating_count")
  /// Link a TODAS las reseñas del local (distinto de `defaultReviewRedirectUrl`,
  /// que abre directamente la pantalla de escribir una reseña).
  googlePlaceReviewsUri        String?           @map("google_place_reviews_uri")
  /// Cuándo se conectó el Place actual (`connectGooglePlace`) — el ancla real
  /// de "reseñas desde que usás Flikker". Se pisa en cada reconexión: el
  /// conteo "desde que conectaste" siempre habla del Place conectado HOY, no
  /// de uno viejo que el negocio pudo haber desconectado.
  googlePlaceConnectedAt       DateTime?         @map("google_place_connected_at")
  whatsappPhoneId              String?           @map("whatsapp_phone_id")
  messageQuotaMonthly          Int               @default(600) @map("message_quota_monthly")
  messageCountCurrentMonth     Int               @default(0) @map("message_count_current_month")
  reviewGoalMonthly            Int               @default(0) @map("review_goal_monthly")
  reviewRequestsPausedUntil    DateTime?         @map("review_requests_paused_until")
  defaultReviewRedirectUrl     String?
  // Check-in dedup + review re-prompt policy. Configurable per business (no
  // panel yet — defaults encode the product rules). The 8h rule is enforced
  // transactionally via an advisory lock, not a static index.
  checkinMinHoursBetweenVisits Int               @default(8) @map("checkin_min_hours_between_visits")
  checkinMaxVisitsPerDay       Int               @default(1) @map("checkin_max_visits_per_day")
  checkinReviewPromptEveryDays Int               @default(30) @map("checkin_review_prompt_every_days")
  // Per-business rollout. Default LEGACY on purpose: every existing business and
  // every new signup stays on the legacy experience unless an admin opts it in.
  experienceVersion            ExperienceVersion @default(LEGACY) @map("experience_version")
  // Reserved for the future retention engine. Persisted only — nothing reads it
  // yet, so toggling it changes no behaviour.
  retentionEngineV2Enabled     Boolean           @default(false) @map("retention_engine_v2_enabled")
  isActive                     Boolean           @default(true)
  createdAt                    DateTime          @default(now())
  updatedAt                    DateTime          @updatedAt
  archivedAt                   DateTime?

  memberships                   Membership[]
  branches                      Branch[]
  subscription                  Subscription?
  auditLogs                     AuditLog[]
  campaigns                     Campaign[]
  campaignExecutions            CampaignExecution[]
  qrCodes                       QrCode[]
  scanEvents                    ScanEvent[]
  reviews                       Review[]
  responses                     Response[]
  widgets                       Widget[]
  customers                     Customer[]
  serviceEvents                 ServiceEvent[]
  messages                      Message[]
  feedbackResponses             FeedbackResponse[]
  googleReviews                 GoogleReview[]
  impersonationLogs             ImpersonationLog[]
  widgetEvents                  WidgetEvent[]
  reviewTags                    ReviewTag[]
  shopifyIntegration            ShopifyIntegration?
  shopifyOrders                 ShopifyOrder[]
  googleCalendarIntegration     GoogleCalendarIntegration?
  calendarEvents                CalendarEvent[]
  manualCampaigns               ManualCampaign[]
  businessPlans                 BusinessPlan[]
  businessGoals                 BusinessGoal[]
  appointmentNotifications      AppointmentNotification[]
  messageTemplates              MessageTemplate[]
  benefits                      Benefit[]
  welcomeBenefit                Benefit?                       @relation("BusinessWelcomeBenefit", fields: [welcomeBenefitId], references: [id], onDelete: SetNull)
  benefitParticipations         BenefitParticipation[]
  retentionSequences            RetentionSequence[]
  retentionSteps                RetentionStep[]
  retentionSends                RetentionSend[]
  raffleDraws                   RaffleDraw[]
  visitSources                  VisitSource[]
  visits                        Visit[]
  customerSessions              CustomerSession[]
  customerVerifications         CustomerVerification[]
  customerEvents                CustomerEvent[]
  retentionSettings             RetentionSettings?
  retentionIncentiveDefinitions RetentionIncentiveDefinition[]
  retentionExperiments          RetentionExperiment[]
  retentionVariants             RetentionVariant[]
  retentionAssignments          RetentionAssignment[]
  retentionDecisionLogs         RetentionDecisionLog[]
  retentionOutcomes             RetentionOutcome[]
  rewardGoals                   CustomerRewardGoal[]
  checkinFeedback               CheckinFeedback[]
  programAuditEvents            ProgramAuditEvent[]
  rewardGoalBonusStamps         RewardGoalBonusStamp[]
  aiUsageEvents                 AiUsageEvent[]
  optimizationRuns              RetentionOptimizationRun[]
  emailLogs                     EmailLog[]
  automationContacts            CustomerAutomationContact[]
  insightSummary                BusinessInsightSummary?
  reactivationFunnelSummary      ReactivationFunnelSummary?
}

// ---------------------------------------------------------------------------
// BusinessInsightSummary (Insights → "Resumen de Flikker" — cache del
// resumen generado por IA, una fila por negocio. El resumen se recalcula
// como máximo una vez por TTL (ver `business-insight-summary.service.ts`) o
// cuando el dueño aprieta "Actualizar análisis" — nunca en cada carga de la
// pantalla, para no llamar al LLM de más.
// ---------------------------------------------------------------------------

model BusinessInsightSummary {
  id         String @id @default(uuid())
  businessId String @unique @map("business_id")

  summaryText String @map("summary_text")
  /// string[], máximo 3 — cada una ya pasó la validación de "todo número
  /// mencionado existe en las métricas que se le pasaron a la IA" antes de
  /// guardarse acá (ver `business-insight-summary.service.ts`).
  recommendations Json

  model         String
  promptVersion String   @map("prompt_version")
  generatedAt   DateTime @map("generated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("business_insight_summaries")
}

/// Cache del resumen IA de "X contactados → Y volvieron → Z% de
/// recuperación" (Retención/Reactivación) — mismo patrón que
/// `BusinessInsightSummary`, tabla propia porque es una métrica distinta con
/// su propio payload (ver `reactivation-funnel-summary.service.ts`). Nunca
/// tiene recomendaciones: la IA solo resume los números que el backend ya
/// calculó.
model ReactivationFunnelSummary {
  id         String @id @default(uuid())
  businessId String @unique @map("business_id")

  summaryText String @map("summary_text")

  model         String
  promptVersion String   @map("prompt_version")
  generatedAt   DateTime @map("generated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("reactivation_funnel_summaries")
}

// ---------------------------------------------------------------------------
// RetentionSettings (Retention Engine V2 — per-business configuration)
// ---------------------------------------------------------------------------
// Deliberately small: the owner configures a handful of business facts, not
// statistical parameters. Every field has a sensible default so the engine can
// run with no configuration at all (REMINDER + CONTROL only, no economics).
//
// The kill switch lives on Business.retentionEngineV2Enabled, not here, so it
// stays next to experienceVersion and can be flipped by a platform admin.

model RetentionSettings {
  id         String @id @default(uuid())
  businessId String @unique @map("business_id")

  /// Declared by the owner — an ESTIMATE, not real sales. Kept nullable so the
  /// engine works without it (economics are simply not shown).
  averageTicketAmount    Decimal? @map("average_ticket_amount") @db.Decimal(12, 2)
  /// 0-100. Also a declared estimate.
  estimatedMarginPercent Int?     @map("estimated_margin_percent")

  /// When false the engine still evaluates and reports, but sends nothing.
  automaticCampaignsEnabled Boolean @default(true) @map("automatic_campaigns_enabled")

  // Contact pressure limits — the owner's protection against over-messaging.
  minimumDaysBetweenRetentionMessages Int @default(14) @map("minimum_days_between_retention_messages")
  maximumRetentionMessagesPer30Days   Int @default(2) @map("maximum_retention_messages_per_30_days")

  /// Local sending window, evaluated in the business timezone.
  sendingHourStart   Int   @default(10) @map("sending_hour_start")
  sendingHourEnd     Int   @default(20) @map("sending_hour_end")
  /// ISO weekdays allowed to send (1 = Monday … 7 = Sunday).
  allowedSendingDays Int[] @default([1, 2, 3, 4, 5, 6]) @map("allowed_sending_days")

  /// Share of eligible customers held back as control. Never allowed to reach
  /// 0 by the optimizer — without control there is no causal read.
  controlGroupPercent                 Int @default(15) @map("control_group_percent")
  /// Below this many participants a variant is reported as INSUFFICIENT_DATA.
  minimumSampleSizeForRecommendations Int @default(30) @map("minimum_sample_size_for_recommendations")

  // Economic safety caps (Fase C.5) — the owner's protection against an
  // experiment misconfiguration issuing unlimited benefits. Both nullable:
  // null means "not configured", which the send path treats as "no incentive
  // may be issued automatically" rather than as "unlimited" — see
  // RetentionBudgetService. A UI must warn the owner while either is unset and
  // automation with incentive-bearing variants is on.
  maxAutomatedIncentivesPerMonth    Int?     @map("max_automated_incentives_per_month")
  maxEstimatedIncentiveCostPerMonth Decimal? @map("max_estimated_incentive_cost_per_month") @db.Decimal(12, 2)

  /// Pilot mode: the engine recruits and decides as usual but never creates a
  /// sendable Message, issues a benefit, or calls WhatsApp. Meant to let an
  /// owner observe a few days of decisions before trusting live sending.
  dryRunEnabled Boolean @default(false) @map("dry_run_enabled")

  // Fase E — Reward Goals ("te faltan N visitas para X"). Off by default: an
  // owner opts in explicitly, same philosophy as automation above.
  rewardGoalsEnabled                 Boolean @default(false) @map("reward_goals_enabled")
  /// Capacidad independiente de `rewardGoalsEnabled` (sellos): visibilidad
  /// pública del catálogo de Beneficios — regalo de bienvenida y el
  /// beneficio activo del check-in (`BenefitsService#resolveActiveBenefit`/
  /// `getWelcomeGiftState`/`grantWelcomeGift`). Default `true` a propósito:
  /// todo negocio existente ya se comportaba así (no había ningún gate), así
  /// que esto es puramente aditivo hasta que alguien lo apaga explícitamente
  /// desde Programa → Configuración. Apagarlo NUNCA borra el catálogo ni el
  /// historial — solo deja de mostrarlo/entregarlo en el check-in público,
  /// igual que `rewardGoalsEnabled` con la tarjeta de sellos. Sellos y
  /// Beneficios son capacidades independientes: cualquier combinación de
  /// ambos flags es válida (Fiddelik-style "activar/desactivar por separado").
  benefitsEnabled                    Boolean @default(true) @map("benefits_enabled")
  /// Optional override range for how many additional visits a goal may ask
  /// for. Null means "the engine's own per-segment defaults apply" — the
  /// owner is never required to configure this (Fase E §30/§31).
  rewardGoalMinVisits                Int?    @map("reward_goal_min_visits")
  rewardGoalMaxVisits                Int?    @map("reward_goal_max_visits")
  /// Owner-configurable toggle for the "+1 sello extra" feedback bonus
  /// (§9 pilot follow-up). Defaults to FALSE — opt-in only. This feature has
  /// never been deployed, so there is no live "on" behaviour to preserve;
  /// defaulting to on would have let existing businesses start giving out
  /// stamps automatically the moment this migration ran, with nobody having
  /// asked for it. When false, `CheckinFeedback` is still saved as always;
  /// only the `RewardGoalBonusStamp` is skipped — never a partial/half bonus.
  rewardGoalFeedbackBonusEnabled     Boolean @default(false) @map("reward_goal_feedback_bonus_enabled")
  /// Recordatorios de progreso hacia una tarjeta ya activa (objetivo
  /// REWARD_GOAL_PROGRESS). Interruptor PROPIO, separado de
  /// : sin esto los dos toggles del onboarding
  /// ("recordar cerca del premio" y "reactivar clientes") serían alias del
  /// mismo campo y no podrían activarse por separado.
  progressReminderEnabled            Boolean @default(false) @map("progress_reminder_enabled")
  /// Notificaciones (Free) — email de "sellos por vencer": cuando un cliente
  /// completó su tarjeta y el premio (BenefitParticipation) todavía no fue
  /// canjeado y está por vencer. Independiente de `progressReminderEnabled`
  /// (eso es WhatsApp, "casi llegás"); esto es el aviso de vencimiento del
  /// premio YA ganado, y no tiene costo de plan — disponible en Free. Off
  /// por default, mismo criterio que el resto de estos toggles.
  stampsExpiryEmailEnabled           Boolean @default(false) @map("stamps_expiry_email_enabled")
  /// Notificaciones (Pro) — email de cumpleaños. No hay un objetivo de
  /// Retention V2 para esto (no es un problema de recruitment/control group,
  /// es un calendario): se resuelve con un sweep diario propio
  /// (`BirthdayEmailService`), no con un experimento nuevo. Off por default.
  birthdayEmailEnabled               Boolean @default(false) @map("birthday_email_enabled")
  /// Days after a goal is UNLOCKED (or CANCELLED/EXPIRED) before the engine
  /// will consider creating another one for the same customer — the guard
  /// against "immediately after unlocking, infinite new goals" (Fase E §33).
  rewardGoalCooldownDays             Int     @default(3) @map("reward_goal_cooldown_days")
  /// Ceiling on how many goals may be simultaneously promised (ACTIVE or
  /// UNLOCKED-not-yet-redeemed) against ANY single incentive definition —
  /// the minimal capacity guard from Fase E §10. Null keeps today's
  /// per-incentive `maxTotalRedemptions`/`maxRedemptionsPerCustomer` as the
  /// only ceiling.
  maxPromisedRewardGoalsPerIncentive Int?    @map("max_promised_reward_goals_per_incentive")

  // Fase F — AI Layer per-business opt-in (§5). Off by default, same
  // philosophy as automaticCampaignsEnabled/rewardGoalsEnabled above: AI
  // never decides anything commercial regardless of these — they only gate
  // whether copy/explanations may be AI-written instead of the deterministic
  // template/numbers. Lives here (not on Business) because every other
  // retention-pilot toggle already does, and the owner already manages all
  // of them from the same settings screen.
  aiCopyEnabled     Boolean @default(false) @map("ai_copy_enabled")
  aiInsightsEnabled Boolean @default(false) @map("ai_insights_enabled")

  // Fase G — Safe Auto-Optimization. OFF by default: the engine keeps
  // running perfectly with fixed allocations until an owner opts in
  // explicitly. One enum, not a boolean + a mode, per Fase G §29 — OFF
  // already means "disabled", so a separate autoOptimizationEnabled flag
  // would only duplicate it.
  optimizationMode                        OptimizationMode @default(OFF) @map("optimization_mode")
  /// CONTROL is never allowed to drop below this share, no matter how
  /// clearly a variant is winning (Fase G §7).
  minimumControlPercent                   Int              @default(10) @map("minimum_control_percent")
  /// Every non-winning variant, COMBINED, keeps at least this much share —
  /// Flikker never collapses to "control + one winner" (Fase G §8).
  minimumExplorationPercent               Int              @default(15) @map("minimum_exploration_percent")
  /// Ceiling on how many percentage points a single variant may move in one
  /// optimization round (Fase G §9) — protects against reacting to noise.
  maxAllocationChangePerOptimization      Int              @default(15) @map("max_allocation_change_per_optimization")
  /// Minimum time between two applied optimizations on the SAME experiment,
  /// regardless of new outcomes arriving (Fase G §22 — anti-oscillation).
  optimizationCooldownHours               Int              @default(72) @map("optimization_cooldown_hours")
  /// Stricter floor than minimumSampleSize, required specifically for
  /// AUTOMATIC (Fase G §37). Null falls back to minimumSampleSize itself.
  minimumExposedPerVariantForOptimization Int?             @map("minimum_exposed_per_variant_for_optimization")
  /// Hysteresis (Fase G §23): an uplift/net-value gap smaller than this many
  /// percentage points is never "meaningful" enough to justify moving share
  /// away from whichever variant is already favored.
  minimumMeaningfulUpliftPoints           Int              @default(5) @map("minimum_meaningful_uplift_points")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("retention_settings")
}

enum OptimizationMode {
  OFF
  /// Flikker computes and stores a proposal but never applies it — the owner
  /// must confirm via the apply endpoint (Fase G §29).
  ASSISTED
  /// The worker applies a safe proposal automatically, within every limit
  /// above (Fase G §29).
  AUTOMATIC
}

enum OptimizationRunStatus {
  /// Computed and stored, nothing changed yet — manual preview, or the
  /// stored result of a dry-run pass (Fase G §33).
  PREVIEWED
  /// Allocation actually changed on the experiment's variants.
  APPLIED
  /// A later run that restored a previous APPLIED run's allocations.
  ROLLED_BACK
  /// Eligibility failed — nothing computed to change; `reasonCode` says why.
  SKIPPED
}

enum OptimizationTrigger {
  AUTOMATIC_WORKER
  MANUAL_PREVIEW
  MANUAL_APPLY
  MANUAL_ROLLBACK
}

// ---------------------------------------------------------------------------
// RetentionOptimizationRun (Fase G §15/§16 — the allocation's audit trail)
// ---------------------------------------------------------------------------
// This IS the allocation version history — no separate
// RetentionAllocationVersion table. A running experiment's `allocationPercent`
// can ONLY ever change through this system (see
// RetentionExperimentsAdminService.requireDraft — every OTHER admin write
// path is frozen once an experiment leaves DRAFT), so every change to a
// RUNNING experiment's allocation is, by construction, one of these rows.
// Reconstructing "which allocation was in effect at time T" is: the most
// recent APPLIED run with `appliedAt <= T`, or the experiment's own
// variant.allocationPercent as first configured in DRAFT if none exists yet.
model RetentionOptimizationRun {
  id           String                @id @default(uuid())
  businessId   String                @map("business_id")
  experimentId String                @map("experiment_id")
  status       OptimizationRunStatus
  triggeredBy  OptimizationTrigger   @map("triggered_by")

  /// 'BEST_ECONOMIC_VARIANT' | 'BEST_RETURN_VARIANT' | 'NO_CONCLUSION' — a
  /// plain string, mirroring WinnerConclusion's own `kind`, never re-typed.
  objectiveUsed   String? @map("objective_used")
  winnerVariantId String? @map("winner_variant_id")
  /// One of the Fase G §40 OPTIMIZATION_* decision codes — the same table
  /// RetentionDecisionLogService already writes to also gets one entry per
  /// run; this column is the fast, structured summary on the run itself.
  reasonCode      String  @map("reason_code")

  /// {variantId: allocationPercent} — always present, always sums to 100.
  previousAllocations Json  @map("previous_allocations")
  proposedAllocations Json  @map("proposed_allocations")
  /// Null unless status is APPLIED or ROLLED_BACK — what actually got
  /// written to the variants, which may differ from `proposedAllocations`
  /// if nothing was safe to change.
  appliedAllocations  Json? @map("applied_allocations")

  /// Per-variant returnRate/evidenceState/economics, exactly as read from
  /// RetentionExperimentMetricsService — never chain-of-thought, never a
  /// prompt. Fase G §15.
  metricsSnapshot  Json @map("metrics_snapshot")
  /// Holm-Bonferroni-adjusted significance read used for this decision.
  evidenceSnapshot Json @map("evidence_snapshot")

  /// True when RetentionSettings.dryRunEnabled was on when this ran (Fase G
  /// §33) — computed and logged, never applied.
  dryRun Boolean @default(false) @map("dry_run")

  createdAt DateTime  @default(now()) @map("created_at")
  appliedAt DateTime? @map("applied_at")

  business   Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  experiment RetentionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, createdAt])
  @@index([businessId])
  @@map("retention_optimization_runs")
}

// ---------------------------------------------------------------------------
// RetentionIncentiveDefinition (catalogue of incentives Flikker MAY offer)
// ---------------------------------------------------------------------------
// A catalogue of AUTHORIZED STRATEGIES — deliberately NOT a second benefits
// system. When a variant actually has to hand something to a customer, the
// definition is translated into the existing Benefit / BenefitParticipation
// reward and redeemed through the existing flow. There is one redemption path,
// not two.
//
// It cannot reuse `Benefit` directly: that table enforces
// `benefits_one_active_per_business` (at most one active benefit per business,
// which the QR/check-in flow relies on), whereas a catalogue needs several
// authorized options active simultaneously. It also lacks cost, usage limits
// and automation-eligibility.
//
// Nothing may ever be offered that is not a row here: no invented discount, no
// raised percentage, no new commercial terms.

model RetentionIncentiveDefinition {
  id         String      @id @default(uuid())
  businessId String      @map("business_id")
  name       String
  type       BenefitType

  /// Percentage off, for "10% OFF"-style incentives.
  percentageValue Int?     @map("percentage_value")
  /// Fixed amount off, for "$100 OFF"-style incentives.
  fixedValue      Decimal? @map("fixed_value") @db.Decimal(12, 2)
  /// What one redemption costs the business. For percentage discounts it can be
  /// derived from the average ticket; this is the override for things like a
  /// free upgrade whose real cost only the owner knows.
  estimatedCost   Decimal? @map("estimated_cost") @db.Decimal(12, 2)

  description   String?
  conditions    String?
  /// Days the issued reward stays valid. Short windows drive urgency.
  expiresInDays Int     @default(7) @map("expires_in_days")

  active             Boolean @default(true)
  /// Explicit owner consent for the engine to use this automatically. Off by
  /// default: authorizing automation is always an opt-in.
  automationEligible Boolean @default(false) @map("automation_eligible")
  /// Fase E §1 — separate opt-in for the Reward Goal engine. Deliberately its
  /// own flag rather than reusing `automationEligible`: a business may want an
  /// incentive available for AT_RISK recovery campaigns but not as a visible
  /// "N visits away" reward goal, or vice-versa. Same catalogue, two
  /// independent authorizations.
  rewardGoalEligible Boolean @default(false) @map("reward_goal_eligible")

  maxRedemptionsPerCustomer Int?  @map("max_redemptions_per_customer")
  maxTotalRedemptions       Int?  @map("max_total_redemptions")
  /// ISO weekdays this incentive may be offered on (1 = Monday … 7 = Sunday).
  /// Empty means "no day restriction".
  validDays                 Int[] @default([]) @map("valid_days")

  /// Piloto V2 — bridge to the owner-facing Benefit this catalogue row was
  /// created from. Nullable + unique: at most one definition per Benefit,
  /// same 1:1 pattern as `RetentionVariant.issuedBenefitId`. Rows created
  /// before this bridge existed (or created directly, bypassing Beneficios)
  /// keep `benefitId: null` and keep working exactly as before — this column
  /// only ever gets set going forward, never backfilled.
  benefitId String? @unique @map("benefit_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business    Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  benefit     Benefit?             @relation(fields: [benefitId], references: [id], onDelete: SetNull)
  variants    RetentionVariant[]
  rewardGoals CustomerRewardGoal[]

  @@index([businessId])
  @@index([businessId, active, automationEligible])
  @@index([businessId, active, rewardGoalEligible])
  @@map("retention_incentive_definitions")
}

// ---------------------------------------------------------------------------
// RetentionExperiment / RetentionVariant / RetentionAssignment (Phase B)
// ---------------------------------------------------------------------------
// The experiment is what makes causality readable: a share of eligible
// customers is held back as CONTROL and receives nothing, so "how many would
// have come back anyway?" has an answer.

model RetentionExperiment {
  id         String                    @id @default(uuid())
  businessId String                    @map("business_id")
  name       String
  objective  RetentionObjective
  /// Segment this experiment recruits from. Null = any eligible segment.
  segment    CustomerSegment?
  status     RetentionExperimentStatus @default(DRAFT)

  startAt DateTime  @default(now()) @map("start_at")
  endAt   DateTime? @map("end_at")

  /// Days after assignment during which a return counts for this experiment.
  attributionWindowDays Int @default(30) @map("attribution_window_days")
  /// Below this many participants per variant, results stay INSUFFICIENT_DATA.
  minimumSampleSize     Int @default(30) @map("minimum_sample_size")
  /// Share held back as control. Snapshotted here so changing the business
  /// setting later does not silently rewrite a running experiment.
  controlPercent        Int @default(15) @map("control_percent")

  /// True only for experiments RetentionV2BootstrapService created and owns.
  /// This is provenance, not derivable from any other field — a Platform Admin
  /// experiment and a self-service default one can look structurally
  /// identical (same objective, same CONTROL+REMINDER shape). The bootstrap
  /// service reads this to know which experiments it may ever finish/replace
  /// with a new generation, and refuses to touch anything false (see §15 —
  /// hand-configured setups are never superseded automatically).
  managedBySelfService Boolean @default(false) @map("managed_by_self_service")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business         Business                   @relation(fields: [businessId], references: [id], onDelete: Cascade)
  variants         RetentionVariant[]
  assignments      RetentionAssignment[]
  outcomes         RetentionOutcome[]
  optimizationRuns RetentionOptimizationRun[]

  @@index([businessId])
  @@index([businessId, status])
  @@map("retention_experiments")
}

model RetentionVariant {
  id           String                @id @default(uuid())
  experimentId String                @map("experiment_id")
  businessId   String                @map("business_id")
  name         String
  strategyType RetentionStrategyType

  /// Only set for benefit-bearing strategies, and only ever pointing at an
  /// authorized catalogue row.
  incentiveDefinitionId String? @map("incentive_definition_id")
  /// The Benefit row this variant issues through, created lazily and kept
  /// `active: false` so it never competes for the single-active-benefit slot
  /// the QR flow relies on. Individual rewards hang off it as
  /// BenefitParticipation rows, reusing the existing redemption flow.
  issuedBenefitId       String? @unique @map("issued_benefit_id")

  /// Share of participants routed here. Validated to sum to 100 with control.
  allocationPercent Int     @map("allocation_percent")
  active            Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  experiment          RetentionExperiment           @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  business            Business                      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  incentiveDefinition RetentionIncentiveDefinition? @relation(fields: [incentiveDefinitionId], references: [id], onDelete: SetNull)
  issuedBenefit       Benefit?                      @relation(fields: [issuedBenefitId], references: [id], onDelete: SetNull)
  assignments         RetentionAssignment[]
  outcomes            RetentionOutcome[]

  @@index([experimentId])
  @@index([businessId])
  @@map("retention_variants")
}

// One row per (experiment, customer). The unique constraint is what makes
// assignment idempotent under concurrent worker runs: a customer can never end
// up in two variants of the same experiment.

model RetentionAssignment {
  id           String @id @default(uuid())
  experimentId String @map("experiment_id")
  variantId    String @map("variant_id")
  businessId   String @map("business_id")
  customerId   String @map("customer_id")

  /// Snapshot of the behaviour that justified recruiting this customer. Kept on
  /// the row because the live values keep moving and reports must stay
  /// reproducible.
  segmentAtAssignment    CustomerSegment @map("segment_at_assignment")
  visitCountAtAssignment Int             @map("visit_count_at_assignment")
  daysSinceLastVisit     Int             @map("days_since_last_visit")
  /// Median days between visits when there was enough history, else null.
  typicalIntervalDays    Int?            @map("typical_interval_days")

  assignedAt DateTime @default(now()) @map("assigned_at")

  status     RetentionAssignmentStatus @default(PENDING)
  sentAt     DateTime?                 @map("sent_at")
  /// The moment this assignment was actually exposed to its arm — the message
  /// was created (SENT) or the customer was confirmed into the control group
  /// (OBSERVING). This, not `assignedAt`, is what an outcome's observation
  /// window is measured from: recruitment and exposure can be hours or days
  /// apart (the sending window, a paused experiment, a retry). A separate
  /// column rather than overloading `sentAt` for CONTROL keeps the existing
  /// cooldown/`lastRetentionMessageAt` semantics (which key off `sentAt`
  /// meaning "a message was actually sent") untouched.
  exposedAt  DateTime?                 @map("exposed_at")
  /// Eligibility rejection code from the re-check just before sending.
  skipReason String?                   @map("skip_reason")

  /// The one message this assignment produced. Unique: it is what makes the
  /// send worker idempotent — a retry cannot attach a second message.
  messageId              String? @unique @map("message_id")
  /// The one individual reward issued for this assignment, when the variant
  /// carries an incentive. Unique for the same reason.
  benefitParticipationId String? @unique @map("benefit_participation_id")

  business             Business               @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)
  experiment           RetentionExperiment    @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant              RetentionVariant       @relation(fields: [variantId], references: [id], onDelete: Cascade)
  message              Message?               @relation(fields: [messageId], references: [id], onDelete: SetNull)
  benefitParticipation BenefitParticipation?  @relation(fields: [benefitParticipationId], references: [id], onDelete: SetNull)
  decisions            RetentionDecisionLog[]
  outcome              RetentionOutcome?

  @@unique([experimentId, customerId])
  @@index([businessId, status])
  @@index([businessId])
  @@index([customerId])
  @@index([variantId])
  @@index([status, exposedAt])
  @@map("retention_assignments")
}

// ---------------------------------------------------------------------------
// RetentionOutcome (Fase D — closing the experimental loop)
// ---------------------------------------------------------------------------
// The observable result of one exposed assignment: did this customer come
// back within the experiment's attribution window? This is what turns "we
// sent messages" into "control returned 8%, the benefit variant returned
// 22%" — the causal read the whole CONTROL group exists to make possible.
//
// At most one FINAL outcome per assignment (`@unique` on assignmentId), and it
// is written at most twice: once when a qualifying return is found (`returned:
// true`, as soon as it happens — never waiting for the window to close), and
// once when the window closes with nothing found (`returned: false`). A
// `returned: true` outcome may still be updated in place while its window is
// open, ONLY to upgrade `confirmedByRedemption`/`attributionType` if a
// redemption becomes visible later — never to flip `returned` itself.
//
// Deliberately reuses `Visit.attributionType` instead of re-deriving
// attribution: the check-in flow has already done that work when the return
// visit was created (see `VisitsRepository.resolveVisitAttribution`).
model RetentionOutcome {
  id           String @id @default(uuid())
  businessId   String @map("business_id")
  experimentId String @map("experiment_id")
  variantId    String @map("variant_id")
  assignmentId String @unique @map("assignment_id")
  customerId   String @map("customer_id")

  returned      Boolean   @map("returned")
  returnVisitId String?   @map("return_visit_id")
  returnedAt    DateTime? @map("returned_at")
  /// Days between exposure (`RetentionAssignment.exposedAt`) and the return
  /// visit. Null when there was no return.
  daysToReturn  Int?      @map("days_to_return")

  /// Copied from the return Visit — `null` when there was no return. Left as
  /// `organic` for a CONTROL return: nothing was sent to attribute it to.
  attributionType        VisitAttributionType? @map("attribution_type")
  /// True when `RetentionAssignment.benefitParticipationId`'s own redemption
  /// happened by the time this outcome was (last) computed. The single
  /// source of truth is `BenefitParticipation.redeemedAt`, not a guess from
  /// Visit metadata.
  confirmedByRedemption  Boolean               @default(false) @map("confirmed_by_redemption")
  /// Denormalized copy of `RetentionAssignment.benefitParticipationId`, kept
  /// here so a metrics query never has to join through the assignment.
  benefitParticipationId String?               @map("benefit_participation_id")

  /// True exactly when `returned` is true — kept as its own column because it
  /// is the field the schema in Fase D's spec calls out, and because a return
  /// discovered by other means in a later phase would not automatically imply
  /// "within window".
  observedWithinWindow Boolean @map("observed_within_window")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business    Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  experiment  RetentionExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  variant     RetentionVariant    @relation(fields: [variantId], references: [id], onDelete: Cascade)
  assignment  RetentionAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  customer    Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  returnVisit Visit?              @relation(fields: [returnVisitId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([experimentId, variantId])
  @@index([variantId, returned])
  @@map("retention_outcomes")
}

// ---------------------------------------------------------------------------
// CustomerRewardGoal (Fase E — "te faltan N visitas para X")
// ---------------------------------------------------------------------------
// Visible, per-business progress toward an authorized reward. Deliberately
// NOT a points/currency ledger (Fase E §2): `progressVisits` is always
// derived from real `Visit` rows created after `activatedAt`, never a balance
// that could drift out of sync or be spent independently of an actual visit.
//
// At most one ACTIVE goal per (businessId, customerId) — enforced by a
// hand-authored partial unique index in the migration (Prisma has no native
// "unique where" attribute), the same technique already used for
// `benefits_one_active_per_business`. A customer may still have any number of
// REDEEMED/EXPIRED/CANCELLED goals in their history.
model CustomerRewardGoal {
  id                    String           @id @default(uuid())
  businessId            String           @map("business_id")
  customerId            String           @map("customer_id")
  incentiveDefinitionId String           @map("incentive_definition_id")
  status                RewardGoalStatus @default(ACTIVE)

  /// Visit count the customer already had when this goal was created — never
  /// recount visits from before the goal existed.
  startingVisitCount     Int @map("starting_visit_count")
  /// How many NEW visits (beyond startingVisitCount) unlock the reward.
  targetAdditionalVisits Int @map("target_additional_visits")

  createdAt   DateTime  @default(now()) @map("created_at")
  /// Bumped on every write — used as "when did this goal last change status",
  /// which is what the post-close cooldown (Fase E §33) measures from.
  updatedAt   DateTime  @updatedAt @map("updated_at")
  /// Equal to createdAt today (goals are created already active) — kept as
  /// its own column because it is the field visit-counting is measured from,
  /// so it stays correct even if a future "queued, not yet active" state is
  /// introduced.
  activatedAt DateTime  @default(now()) @map("activated_at")
  expiresAt   DateTime? @map("expires_at")
  unlockedAt  DateTime? @map("unlocked_at")
  redeemedAt  DateTime? @map("redeemed_at")
  cancelledAt DateTime? @map("cancelled_at")

  /// Always 'reward_goal_engine' for now — kept as a column (not hardcoded)
  /// because a future manual override belongs here, not as a second model.
  source            String          @default("reward_goal_engine")
  /// Stable machine-readable reason, mirroring how segmentation/eligibility
  /// already justify their decisions (e.g. 'NEW_SECOND_VISIT').
  reasonCode        String          @map("reason_code")
  segmentAtCreation CustomerSegment @map("segment_at_creation")

  /// Set once, on unlock, by the existing IncentiveIssuer — never created
  /// directly by this model. Unique: the second line of defence (besides the
  /// transaction) against a double unlock.
  benefitParticipationId String? @unique @map("benefit_participation_id")

  business             Business                     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer             Customer                     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  incentiveDefinition  RetentionIncentiveDefinition @relation(fields: [incentiveDefinitionId], references: [id], onDelete: Cascade)
  benefitParticipation BenefitParticipation?        @relation(fields: [benefitParticipationId], references: [id], onDelete: SetNull)
  /// Progreso adicional otorgado por completar el feedback post-check-in —
  /// nunca una Visit falsa. Ver comentario de `RewardGoalBonusStamp`.
  bonusStamps          RewardGoalBonusStamp[]

  @@index([businessId, customerId])
  @@index([businessId, status])
  @@index([incentiveDefinitionId, status])
  @@map("customer_reward_goals")
}

// customer_reward_goals_one_active_per_customer — hand-authored partial
// unique index (businessId, customerId) WHERE status IN ('ACTIVE',
// 'UNLOCKED'), see migrations. Prisma has no "unique where" attribute, so
// it never appears above; it's the DB-level backstop for the same guard
// `RewardGoalEngineService.hasActiveGoal` applies in application code — a
// customer never has two live (ACTIVE or UNLOCKED-unredeemed) goals at once.

// ---------------------------------------------------------------------------
// CheckinFeedback — "¿Cómo fue tu experiencia?" shown right after a check-in.
// Deliberately its own model, not a reuse of `FeedbackResponse` (which is
// anchored to an outbound `Message`/WhatsApp campaign — this happens inline,
// live, with no message ever sent). One row per Visit, ever: `visitId` is the
// natural idempotency anchor for "no volver a preguntar por la misma visita".
// ---------------------------------------------------------------------------

model CheckinFeedback {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  customerId String   @map("customer_id")
  visitId    String   @unique @map("visit_id")
  score      Int
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")

  business   Business              @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  visit      Visit                 @relation(fields: [visitId], references: [id], onDelete: Cascade)
  bonusStamp RewardGoalBonusStamp?

  @@index([businessId, createdAt])
  @@index([customerId])
  @@map("checkin_feedback")
}

// ---------------------------------------------------------------------------
// RewardGoalBonusStamp — additive progress source distinct from `Visit`.
// Reward Goal progress today is `Visit.count()` after `activatedAt`; this
// table is summed ALONGSIDE that count, never merged into it and never
// backfilled as a fake Visit — see `RewardGoalUnlockService`/
// `RewardGoalOrchestratorService` for where the two sources are added
// together. `feedbackId` is unique: at most one bonus stamp per feedback
// submission, ever, even under a retry/race.
// ---------------------------------------------------------------------------

model RewardGoalBonusStamp {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  customerId   String   @map("customer_id")
  rewardGoalId String   @map("reward_goal_id")
  feedbackId   String   @unique @map("feedback_id")
  /// Stable, extensible reason — same pattern as `CustomerRewardGoal.reasonCode`.
  /// Only value today, but a string (not an enum) so a future second bonus
  /// type never needs a migration.
  reasonCode   String   @default("feedback_completed") @map("reason_code")
  createdAt    DateTime @default(now()) @map("created_at")

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer   Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  rewardGoal CustomerRewardGoal @relation(fields: [rewardGoalId], references: [id], onDelete: Cascade)
  feedback   CheckinFeedback    @relation(fields: [feedbackId], references: [id], onDelete: Cascade)

  @@index([rewardGoalId])
  @@map("reward_goal_bonus_stamps")
}

// ---------------------------------------------------------------------------
// EmailLog — idempotencia + historial COMPARTIDO para toda notificación por
// email (sellos por vencer, casi llegás, cumpleaños, reactivación,
// promociones). Deliberadamente un log plano, no un motor: la DECISIÓN de a
// quién y cuándo sigue viviendo donde ya vivía (reward goals, Retention V2,
// un sweep de cumpleaños) — esto solo garantiza "nunca dos veces" y "qué
// pasó". `kind`/`dedupeKey` son strings, no enums, para que un tipo nuevo de
// email nunca necesite una migración.
//
// El `@@unique([businessId, kind, dedupeKey])` ES el mecanismo de
// idempotencia: se inserta la fila ANTES de mandar el email (mismo patrón
// que `ensureRedemptionCode`/`RewardGoalBonusStamp`), así que un segundo
// intento (reintento, sweep que corre dos veces) choca contra el índice
// único y nunca duplica el envío. `dedupeKey` es, según el tipo:
//   stamps_expiry     → el id de la BenefitParticipation
//   progress_reminder → el id del Message que Retention V2 ya creó
//   reactivation       → el id del Message que Retention V2 ya creó
//   birthday           → `${año}` (a lo sumo un cumpleaños por año)
//   promotion          → el id del ManualCampaign
/// A pesar del nombre (histórico — nació solo para email), esta tabla ya
/// registra CUALQUIER envío automático de Notificaciones, email o WhatsApp
/// (`channel`). No se renombró el modelo/tabla para no arrastrar ese cambio
/// a los ~8 archivos que ya la usan en esta misma tanda — queda como deuda
/// técnica documentada, no como un error.
model EmailLog {
  id           String    @id @default(uuid())
  businessId   String    @map("business_id")
  customerId   String    @map("customer_id")
  kind         String
  /// 'email' | 'whatsapp'. Default 'email' por las filas de antes de este
  /// campo — todas eran de email en ese momento, así que el default es
  /// exacto, no una adivinanza.
  channel      String    @default("email")
  dedupeKey    String    @map("dedupe_key")
  /// 'sent' | 'failed' | 'suppressed' — nunca 'queued': la fila se crea en
  /// el mismo instante en que se intenta enviar, no antes. 'suppressed' es
  /// del cooldown global (`AutomationCooldownService`): se intentó pero otra
  /// automatización ya había contactado a este cliente en las últimas 24h.
  status       String
  errorMessage String?   @map("error_message")
  sentAt       DateTime? @map("sent_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  /// `channel` entra en la unicidad a propósito: el mismo `dedupeKey` de una
  /// ocurrencia (ej. un año de cumpleaños) reserva un slot POR CANAL, no uno
  /// compartido — así el email y el WhatsApp de la misma ocurrencia pueden
  /// coexistir sin que el segundo se lea como duplicado del primero.
  @@unique([businessId, kind, channel, dedupeKey])
  @@index([businessId, createdAt])
  @@map("email_logs")
}

/// Cooldown central: como máximo 1 mensaje automático por cliente cada 24h,
/// sin importar cuál automatización lo manda. `customerId` es la clave —
/// una fila por cliente, se pisa en cada contacto exitoso. Prioridad al
/// reclamar el slot (documentada, no forzada por este modelo): Cumpleaños >
/// Sellos por vencer > Casi llegás > Te extrañamos/Retention V2 — se logra
/// ordenando CUÁNDO corre cada sweep/dispatcher, no comparando prioridades
/// acá adentro.
model CustomerAutomationContact {
  customerId String @id @map("customer_id")
  businessId String @map("business_id")
  /// Qué automatización tiene el turno — 'birthday' | 'stamps_expiry' |
  /// 'progress_reminder' | 'reactivation'. Prioridad en ese orden.
  kind       String
  /// 'pending' (reservado, todavía no mandó nada) | 'confirmed' (ya mandó).
  /// El período de gracia entre reservar y confirmar es lo que le da
  /// tiempo a una automatización de mayor prioridad a robarle el turno
  /// antes de que se mande cualquier cosa — ver `AutomationCooldownService`.
  status      String
  /// Cuándo se abrió el turno vigente. NO se actualiza cuando una
  /// automatización de mayor prioridad le roba el turno a otra — el reloj
  /// de gracia sigue corriendo desde que el turno se abrió, no desde que
  /// esta automatización se sumó.
  reservedAt  DateTime  @map("reserved_at")
  confirmedAt DateTime? @map("confirmed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("customer_automation_contacts")
}

// ---------------------------------------------------------------------------
// AI Layer (Fase F) — observability/cost tracking only. The AI never writes
// here to decide anything; every row is a record of ONE generation attempt.
// ---------------------------------------------------------------------------

/// What produced a Message's final body. DETERMINISTIC_DISABLED and
/// DETERMINISTIC_FALLBACK both mean "the existing template ran" — the only
/// difference is whether AI was even attempted.
enum AiCopySource {
  AI
  DETERMINISTIC_FALLBACK
  DETERMINISTIC_DISABLED
}

/// One row per AI generation attempt (Fase F §6/§43). Never stores the
/// prompt or any customer contact info — just enough to compute daily/monthly
/// caps, success/fallback rates, latency and (when the provider reports them)
/// token counts, per business and per use case.
model AiUsageEvent {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  /// One of the AiUseCase constants (RETENTION_MESSAGE, INSIGHT_EXPLANATION,
  /// ...) — a plain string, not an enum, so a new use case never needs a
  /// migration to exist.
  useCase          String   @map("use_case")
  model            String
  promptVersion    String   @map("prompt_version")
  success          Boolean
  fallbackUsed     Boolean  @map("fallback_used")
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  estimatedCostUsd Decimal? @map("estimated_cost_usd") @db.Decimal(10, 6)
  latencyMs        Int?     @map("latency_ms")
  /// Debugging aid only (Fase F §43) — never the customer's phone/email.
  customerId       String?  @map("customer_id")
  createdAt        DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  message  Message?

  @@index([businessId, useCase, createdAt])
  @@index([businessId, createdAt])
  @@map("ai_usage_events")
}

// ---------------------------------------------------------------------------
// RetentionDecisionLog (why the engine did what it did)
// ---------------------------------------------------------------------------
// Append-only audit trail of automatic decisions. Stores structured decision
// codes and the inputs behind them — never free-form reasoning.

model RetentionDecisionLog {
  id           String   @id @default(uuid())
  businessId   String   @map("business_id")
  customerId   String?  @map("customer_id")
  assignmentId String?  @map("assignment_id")
  /// Stable code: ELIGIBLE, CONTROL, ASSIGNED, SKIPPED_RETURNED,
  /// SKIPPED_OPT_OUT, SKIPPED_COOLDOWN, SKIPPED_ENGINE_DISABLED,
  /// SKIPPED_EXPERIMENT_PAUSED, MESSAGE_QUEUED, MESSAGE_FAILED, BENEFIT_ISSUED.
  decisionCode String   @map("decision_code")
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  business   Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  assignment RetentionAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([assignmentId])
  @@map("retention_decision_logs")
}

// ---------------------------------------------------------------------------
// ImpersonationLog (audited platform-admin business access)
// ---------------------------------------------------------------------------

model ImpersonationLog {
  id               String   @id @default(uuid())
  adminId          String
  targetBusinessId String
  createdAt        DateTime @default(now())

  admin          User     @relation(fields: [adminId], references: [id])
  targetBusiness Business @relation(fields: [targetBusinessId], references: [id])

  @@index([adminId])
  @@index([targetBusinessId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Branch (physical location of a business)
// ---------------------------------------------------------------------------

model Branch {
  id         String   @id @default(uuid())
  businessId String
  name       String
  slug       String
  address    String?
  city       String?
  state      String?
  phone      String?
  email      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business   Business    @relation(fields: [businessId], references: [id])
  campaigns  Campaign[]
  qrCodes    QrCode[]
  scanEvents ScanEvent[]
  reviews    Review[]

  @@unique([businessId, slug])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Membership (user <-> business, with role and status)
// ---------------------------------------------------------------------------

model Membership {
  id              String           @id @default(uuid())
  userId          String
  businessId      String
  role            MembershipRole
  status          MembershipStatus @default(ACTIVE)
  invitedByUserId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  user      User     @relation("UserMemberships", fields: [userId], references: [id])
  business  Business @relation(fields: [businessId], references: [id])
  invitedBy User?    @relation("InvitedByUser", fields: [invitedByUserId], references: [id])

  @@unique([userId, businessId])
  @@index([userId])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// PasswordResetToken
// ---------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// EmailVerificationToken
// ---------------------------------------------------------------------------

/// Mismo patrón que PasswordResetToken a propósito: un solo uso, con
/// expiración y `usedAt`, reenviable sin invalidar tokens previos (igual que
/// el reset de contraseña). Confirmar el correo consume el token Y arranca
/// una sesión real — es la única forma en que un usuario recién confirmado
/// entra a `/comenzar`.
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Plan (logical pricing tiers — no billing integration yet)
// ---------------------------------------------------------------------------

model Plan {
  id                  String   @id @default(uuid())
  name                String
  slug                String   @unique
  description         String?
  maxBranches         Int
  maxMembers          Int
  maxCampaigns        Int
  maxReviewsPerMonth  Int
  /// Self-service: tope de clientes IDENTIFICADOS PARTICIPANTES de la tarjeta
  /// de sellos (con al menos un CustomerRewardGoal alguna vez, cualquier
  /// status — mismo criterio que `LoyaltyProgramService#getOverview`). Null
  /// = sin tope (todo plan que no sea el FREE self-service de sellos). Vive
  /// en el plan, no en Business, para que cambiar de plan cambie el límite
  /// sin tocar cada negocio.
  maxCustomers        Int?
  priceMonthly        Int      @default(0)
  priceUsd            Int      @default(0)
  setupFeeUsd         Int      @default(0)
  /// Moneda de `priceAmount` (ISO 4217, ej. "USD", "UYU"). Default "USD"
  /// para no cambiar el significado de los planes ya existentes
  /// (starter/pro), que siguen siendo USD vía `priceUsd`. Genérico a
  /// propósito: `priceUsd`/`priceMonthly` quedan como el histórico en dólares,
  /// pero un plan nuevo en otra moneda (ej. Pro self-service en UYU) usa
  /// `currency`/`priceAmount` en vez de forzar una conversión falsa a USD.
  currency            String   @default("USD")
  /// Precio en unidades enteras de `currency` (ej. 1000 para "UYU 1.000",
  /// nunca centavos) — lo que muestra Configuración → Suscripción. Para
  /// starter/pro (USD) coincide con `priceUsd`.
  priceAmount         Int      @default(0)
  messageQuotaMonthly Int      @default(0)
  trialDays           Int      @default(0)
  isActive            Boolean  @default(true)
  displayOrder        Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  subscriptions Subscription[]
}

// ---------------------------------------------------------------------------
// Subscription (business <-> plan, one active per business)
// ---------------------------------------------------------------------------

model Subscription {
  id                 String             @id @default(uuid())
  businessId         String             @unique
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  canceledAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  plan     Plan     @relation(fields: [planId], references: [id])

  @@index([planId])
}

// ---------------------------------------------------------------------------
// AuditLog
// ---------------------------------------------------------------------------

model AuditLog {
  id          String   @id @default(uuid())
  businessId  String
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  actor    User?    @relation(fields: [actorUserId], references: [id])

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Campaign (review acquisition initiative)
// ---------------------------------------------------------------------------

model Campaign {
  id                      String                @id @default(uuid())
  businessId              String
  branchId                String?
  name                    String
  slug                    String
  description             String?
  channel                 CampaignChannel
  templateKind            CampaignTemplateKind? @map("template_kind")
  triggerOffsetDays       Int?                  @map("trigger_offset_days")
  reviewRequestDelayHours Int?                  @default(24) @map("review_request_delay_hours")
  messageBody             String?               @map("message_body")
  offerText               String?               @map("offer_text")
  status                  CampaignStatus        @default(DRAFT)
  destinationType         DestinationType
  destinationUrl          String?
  enableLanding           Boolean               @default(false)
  startsAt                DateTime?
  endsAt                  DateTime?
  createdByUserId         String
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  archivedAt              DateTime?

  business   Business            @relation(fields: [businessId], references: [id])
  branch     Branch?             @relation(fields: [branchId], references: [id])
  createdBy  User                @relation("CampaignCreator", fields: [createdByUserId], references: [id])
  qrCodes    QrCode[]
  scanEvents ScanEvent[]
  reviews    Review[]
  messages   Message[]
  executions CampaignExecution[]
  visits     Visit[]

  @@unique([businessId, slug])
  @@index([businessId])
  @@index([businessId, status])
  @@index([businessId, templateKind, status])
}

// ---------------------------------------------------------------------------
// Customer (final patient/customer contacted for review requests)
// ---------------------------------------------------------------------------

model Customer {
  id               String    @id @default(uuid())
  businessId       String
  name             String
  phoneE164        String    @map("phone_e164")
  email            String?
  birthday         DateTime?
  optedOut         Boolean   @default(false) @map("opted_out")
  isActive         Boolean   @default(true)
  tags             Json?
  origin           String    @default("manual")
  /// Fase E — the global Flikker identity this tenant-scoped Customer belongs
  /// to, once proven. Null until the customer's phone is verified by OTP
  /// (never on a plain, unverified registration — see FlikkerAccount's own
  /// comment for why). Nullable and unbackfilled by design: linking is lazy
  /// and progressive, never a bulk migration of existing rows.
  flikkerAccountId String?   @map("flikker_account_id")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  business                 Business                  @relation(fields: [businessId], references: [id])
  flikkerAccount           FlikkerAccount?           @relation(fields: [flikkerAccountId], references: [id], onDelete: SetNull)
  serviceEvents            ServiceEvent[]
  messages                 Message[]
  campaignExecutions       CampaignExecution[]
  feedbackResponses        FeedbackResponse[]
  manualCampaignContacts   ManualCampaignContact[]
  appointmentNotifications AppointmentNotification[]
  benefitParticipations    BenefitParticipation[]
  retentionSends           RetentionSend[]
  raffleDrawsWon           RaffleDraw[]
  visits                   Visit[]
  sessions                 CustomerSession[]
  verifications            CustomerVerification[]
  events                   CustomerEvent[]
  retentionAssignments     RetentionAssignment[]
  retentionOutcomes        RetentionOutcome[]
  rewardGoals              CustomerRewardGoal[]
  checkinFeedback          CheckinFeedback[]
  rewardGoalBonusStamps    RewardGoalBonusStamp[]
  emailLogs                EmailLog[]
  automationContact        CustomerAutomationContact?

  @@index([businessId])
  @@index([businessId, isActive])
  @@index([businessId, phoneE164])
  @@index([businessId, birthday])
  @@index([businessId, origin])
  @@index([flikkerAccountId])
}

// ---------------------------------------------------------------------------
// FlikkerAccount (Fase E — the customer's global identity, across businesses)
// ---------------------------------------------------------------------------
// A `Customer` row is, and stays, tenant-scoped — that model is untouched.
// This is the seam that lets ONE real person be recognized across several
// businesses, without merging or duplicating any tenant data.
//
// Deliberately requires OTP-verified phone possession before a `Customer` is
// ever linked here (see FlikkerAccountVerification) — a phone typed into a
// plain registration form is NOT proof of ownership (anyone can type anyone
// else's number), and trusting it would let one person's visits/rewards leak
// into a stranger's global account. Linking is lazy and progressive: existing
// Customers are never bulk-migrated, only linked the next time their phone is
// actually verified.
//
// No business-facing endpoint ever reads this table. It exists only for the
// customer-facing "Mi Flikker" surface, authenticated by its own
// FlikkerAccountSession — never by a business's CustomerSession.
model FlikkerAccount {
  id        String   @id @default(uuid())
  phoneE164 String   @unique @map("phone_e164")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  customers Customer[]
  sessions  FlikkerAccountSession[]

  @@map("flikker_accounts")
}

// ---------------------------------------------------------------------------
// FlikkerAccountVerification (Fase E — proves phone ownership before linking)
// ---------------------------------------------------------------------------
// Deliberately a separate, parallel mechanism from `CustomerVerification`
// rather than a modification of it: `CustomerVerification` is keyed by
// `(businessId, customerId)`, which does not exist yet at this point — this
// flow is account-first, phone-first, and runs before any FlikkerAccount is
// known to exist. Copies the exact same proven mechanics (hashed code, TTL,
// max attempts, resend cooldown) instead of inventing a weaker one.
model FlikkerAccountVerification {
  id         String    @id @default(uuid())
  phoneE164  String    @map("phone_e164")
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phoneE164])
  @@index([expiresAt])
  @@map("flikker_account_verifications")
}

// ---------------------------------------------------------------------------
// FlikkerAccountSession (Fase E — the global "Mi Flikker" session)
// ---------------------------------------------------------------------------
// Mirrors `CustomerSession` exactly (hashed token, expiry, revocation) but is
// a completely separate cookie/session — the check-in cookie (`flk_cs`) and
// its business-scoped semantics are untouched. Only "Mi Flikker" ever reads
// this table.
model FlikkerAccountSession {
  id               String    @id @default(uuid())
  flikkerAccountId String    @map("flikker_account_id")
  tokenHash        String    @unique @map("token_hash")
  userAgent        String?   @map("user_agent")
  lastSeenAt       DateTime  @default(now()) @map("last_seen_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  flikkerAccount FlikkerAccount @relation(fields: [flikkerAccountId], references: [id], onDelete: Cascade)

  @@index([flikkerAccountId])
  @@index([expiresAt])
  @@map("flikker_account_sessions")
}

model AppointmentNotification {
  id              String                        @id @default(uuid())
  contactId       String                        @map("contact_id")
  businessId      String                        @map("business_id")
  appointmentDate DateTime                      @map("appointment_date")
  sentAt          DateTime                      @default(now()) @map("sent_at")
  status          AppointmentNotificationStatus

  contact  Customer @relation(fields: [contactId], references: [id])
  business Business @relation(fields: [businessId], references: [id])

  @@index([contactId])
  @@index([businessId])
  @@index([appointmentDate])
}

// ---------------------------------------------------------------------------
// ServiceEvent (attended service that can trigger review request timing)
// ---------------------------------------------------------------------------

model ServiceEvent {
  id          String                 @id @default(uuid())
  businessId  String
  customerId  String
  serviceType String
  eventAt     DateTime
  createdVia  ServiceEventCreatedVia
  createdAt   DateTime               @default(now())

  business Business  @relation(fields: [businessId], references: [id])
  customer Customer  @relation(fields: [customerId], references: [id])
  messages Message[]

  @@index([businessId])
  @@index([customerId])
  @@index([businessId, createdAt])
  @@index([businessId, eventAt])
}

// ---------------------------------------------------------------------------
// Message (outbound review request with unique tracking token)
// ---------------------------------------------------------------------------

model Message {
  id             String         @id @default(uuid())
  businessId     String
  customerId     String
  campaignId     String?
  serviceEventId String?
  channel        MessageChannel
  trackingToken  String         @unique
  status         MessageStatus
  whatsappMsgId  String?        @map("whatsapp_msg_id")
  costUsd        Decimal?       @map("cost_usd")
  /// The exact composed text this message sends. Nullable because every
  /// other message type here already reconstructs its own text at send time
  /// from a template it fully owns (RetentionSend → RetentionStep, review
  /// request copy, ...) — reproducible on demand, so nothing was ever lost
  /// by not storing it. Retention V2 is the one exception: its copy can be
  /// AI-generated per customer (Fase F), which is NOT reproducible from a
  /// static template, so it MUST be captured once, here, at creation time —
  /// see RetentionV2SendService.createMessage(). Only Retention V2 populates
  /// this column today.
  body           String?
  sentAt         DateTime?
  deliveredAt    DateTime?
  readAt         DateTime?
  clickedAt      DateTime?
  createdAt      DateTime       @default(now())
  /// Fase F §18 — how THIS message's body was produced. Null for every
  /// message that predates the AI layer or was never AI-eligible in the
  /// first place (legacy campaigns, review requests, etc.) — only Retention
  /// V2's own AI-eligible sends ever set it.
  copySource     AiCopySource?  @map("copy_source")
  /// The AiUsageEvent this send's generation attempt produced, when AI was
  /// actually invoked (copySource = AI or DETERMINISTIC_FALLBACK). Never set
  /// for DETERMINISTIC_DISABLED, since AI was never called.
  aiUsageEventId String?        @unique @map("ai_usage_event_id")

  business                Business             @relation(fields: [businessId], references: [id])
  customer                Customer             @relation(fields: [customerId], references: [id])
  campaign                Campaign?            @relation(fields: [campaignId], references: [id])
  serviceEvent            ServiceEvent?        @relation(fields: [serviceEventId], references: [id])
  feedbackResponses       FeedbackResponse[]
  campaignExecutions      CampaignExecution[]
  attributedGoogleReviews GoogleReview[]
  retentionSends          RetentionSend[]
  visits                  Visit[]
  /// Present only on messages sent by Retention Engine V2 — this FK is what
  /// identifies a V2 message unambiguously, with no opaque metadata.
  retentionAssignment     RetentionAssignment?
  aiUsageEvent            AiUsageEvent?        @relation(fields: [aiUsageEventId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([campaignId])
  @@index([serviceEventId])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// CampaignExecution (one Repeat campaign contact attempt per customer)
// ---------------------------------------------------------------------------

model CampaignExecution {
  id           String                  @id @default(uuid())
  businessId   String
  campaignId   String
  customerId   String
  messageId    String?
  status       CampaignExecutionStatus @default(queued)
  executedAt   DateTime                @default(now())
  sentAt       DateTime?
  respondedAt  DateTime?
  responseText String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  message  Message? @relation(fields: [messageId], references: [id])

  @@index([businessId])
  @@index([campaignId])
  @@index([customerId])
  @@index([messageId])
  @@index([campaignId, customerId, executedAt])
}

// ---------------------------------------------------------------------------
// FeedbackResponse (rating landing response from a message recipient)
// ---------------------------------------------------------------------------

model FeedbackResponse {
  id                  String   @id @default(uuid())
  businessId          String
  messageId           String
  customerId          String
  score               Int
  comment             String?
  redirectedToGoogle  Boolean
  acknowledgedByOwner Boolean  @default(false)
  createdAt           DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id])
  message  Message  @relation(fields: [messageId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])

  @@index([businessId])
  @@index([messageId])
  @@index([customerId])
  @@index([businessId, createdAt])
}

// ---------------------------------------------------------------------------
// GoogleReview (detected Google Business Profile review)
// ---------------------------------------------------------------------------

model GoogleReview {
  id                  String   @id @default(uuid())
  businessId          String
  googleReviewId      String   @map("google_review_id")
  reviewerName        String?  @map("reviewer_name")
  stars               Int
  text                String?
  /// Fecha REAL de publicación en Google — nunca `detectedAt` (cuándo la
  /// encontramos nosotros). Nullable a propósito: cuando Scrape.do no trae
  /// texto de fecha relativa parseable, `GoogleReviewsProvider` ya NO
  /// inventa "ahora" — guarda `null` en vez de fingir una fecha. La reseña
  /// se conserva igual (cuenta para "Reseñas totales en Google"), pero
  /// nunca para "Reseñas con Flikker" (`postedAt >= Business.createdAt`)
  /// hasta que se pueda determinar su fecha real.
  postedAt            DateTime? @map("posted_at")
  detectedAt          DateTime @default(now()) @map("detected_at")
  attributedMessageId String?  @map("attributed_message_id")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  business          Business @relation(fields: [businessId], references: [id])
  attributedMessage Message? @relation(fields: [attributedMessageId], references: [id])

  @@unique([businessId, googleReviewId])
  @@index([businessId])
  @@index([businessId, postedAt])
  @@index([attributedMessageId])
}

// ---------------------------------------------------------------------------
// QrCode (traceable capture asset linked to a campaign)
// ---------------------------------------------------------------------------

model QrCode {
