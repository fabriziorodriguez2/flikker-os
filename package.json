{
  "name": "flikker-os",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "typecheck": "npm run typecheck --workspace=apps/api && npm run typecheck --workspace=apps/web",
    "lint": "npm run lint:check --workspace=apps/api && npm run lint:check --workspace=apps/web",
    "test": "npm run test --workspace=apps/api",
    "test:e2e:web": "playwright test",
    "test:cov": "npm run test:cov --workspace=apps/api",
    "ci": "npm run typecheck && npm run lint && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabriziorodriguez2/flikker-os.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/fabriziorodriguez2/flikker-os/issues"
  },
  "homepage": "https://github.com/fabriziorodriguez2/flikker-os#readme",
  "dependencies": {
    "concurrently": "^9.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "turbo": "^2.8.20"
  }
}
